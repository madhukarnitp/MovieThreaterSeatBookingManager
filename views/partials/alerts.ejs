<%#
  Aesthetic Square / Solid Accent Toast Notification (Bottom-Center, max ~220px-340px)
  Minimalist modern card with crisp squared edges (rounded-md), solid vibrant surfaces,
  bold contrast typography, and short concise messaging (clamped to at most 5 words).
%>
<%
  // Helper function to format message safely with clean text
  function formatAlertText(str) {
    if (!str || typeof str !== 'string') return '';
    return str.replace(/<[^>]*>?/gm, '').trim();
  }
%>
<style>
  .square-toast-container {
    position: fixed;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    pointer-events: none;
    max-width: 90vw;
  }

  .square-toast {
    pointer-events: auto;
    min-width: 220px;
    max-width: 480px;
    width: fit-content;
    padding: 10px 16px;
    border-radius: 10px;
    box-shadow: 0 12px 28px -4px rgba(0, 0, 0, 0.5), 0 4px 8px -1px rgba(0, 0, 0, 0.3);
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    display: flex;
    align-items: center;
    gap: 10px;
    animation: squareToastIn 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  /* Solid Vibrant Aesthetic Color Themes */
  .square-toast.toast-success {
    background-color: #059669; /* Solid Emerald Green */
    border: 1px solid #10b981;
  }

  .square-toast.toast-danger {
    background-color: #dc2626; /* Solid Crimson Red */
    border: 1px solid #ef4444;
  }

  .square-toast.toast-warning {
    background-color: #d97706; /* Solid Vivid Amber */
    border: 1px solid #f59e0b;
    color: #ffffff;
  }

  .square-toast.toast-info {
    background-color: #2563eb; /* Solid Royal Blue */
    border: 1px solid #3b82f6;
  }

  .square-toast .toast-icon-box {
    width: 20px;
    height: 20px;
    background: rgba(0, 0, 0, 0.18);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    flex-shrink: 0;
  }

  .square-toast .toast-text {
    flex: 1;
    line-height: 1.35;
    word-break: break-word;
    text-align: left;
    font-size: 0.82rem;
  }

  .square-toast .toast-close {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.75);
    cursor: pointer;
    padding: 0;
    margin-left: 2px;
    font-size: 0.9rem;
    line-height: 1;
    display: flex;
    align-items: center;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .square-toast .toast-close:hover {
    color: #ffffff;
    transform: scale(1.15);
  }

  @keyframes squareToastIn {
    0% {
      opacity: 0;
      transform: translateY(18px) scale(0.95);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes squareToastOut {
    0% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    100% {
      opacity: 0;
      transform: translateY(12px) scale(0.95);
    }
  }
</style>

<div class="square-toast-container" id="globalToastContainer">
  <%# Explicit Alert Object %>
  <% if (typeof alert !== 'undefined' && alert && alert.message) { %>
    <div class="square-toast toast-<%= alert.type || 'info' %> alert-dismissible" role="alert" title="<%= alert.message %>">
      <div class="toast-icon-box">
        <% if (alert.type === 'success') { %>
          <i class="bi bi-check-lg"></i>
        <% } else if (alert.type === 'danger') { %>
          <i class="bi bi-x-circle-fill"></i>
        <% } else if (alert.type === 'warning') { %>
          <i class="bi bi-exclamation-triangle-fill"></i>
        <% } else { %>
          <i class="bi bi-info-circle-fill"></i>
        <% } %>
      </div>
      <div class="toast-text"><%= formatAlertText(alert.message) %></div>
      <button type="button" class="toast-close" onclick="dismissSquareToast(this)" aria-label="Close">
        <i class="bi bi-x"></i>
      </button>
    </div>
  <% } %>

  <%# Flash Success Messages %>
  <% if (typeof success_msg !== 'undefined' && success_msg && success_msg.length > 0) { %>
    <% success_msg.forEach(function(msg) { %>
      <div class="square-toast toast-success" role="alert" title="<%= msg %>">
        <div class="toast-icon-box"><i class="bi bi-check-lg"></i></div>
        <div class="toast-text"><%= formatAlertText(msg) %></div>
        <button type="button" class="toast-close" onclick="dismissSquareToast(this)" aria-label="Close">
          <i class="bi bi-x"></i>
        </button>
      </div>
    <% }); %>
  <% } %>

  <%# Flash Error Messages %>
  <% if (typeof error_msg !== 'undefined' && error_msg && error_msg.length > 0) { %>
    <% error_msg.forEach(function(msg) { %>
      <div class="square-toast toast-danger" role="alert" title="<%= msg %>">
        <div class="toast-icon-box"><i class="bi bi-x-circle-fill"></i></div>
        <div class="toast-text"><%= formatAlertText(msg) %></div>
        <button type="button" class="toast-close" onclick="dismissSquareToast(this)" aria-label="Close">
          <i class="bi bi-x"></i>
        </button>
      </div>
    <% }); %>
  <% } %>

  <%# Flash Warning Messages %>
  <% if (typeof warning_msg !== 'undefined' && warning_msg && warning_msg.length > 0) { %>
    <% warning_msg.forEach(function(msg) { %>
      <div class="square-toast toast-warning" role="alert" title="<%= msg %>">
        <div class="toast-icon-box"><i class="bi bi-exclamation-triangle-fill"></i></div>
        <div class="toast-text"><%= formatAlertText(msg) %></div>
        <button type="button" class="toast-close" onclick="dismissSquareToast(this)" aria-label="Close">
          <i class="bi bi-x"></i>
        </button>
      </div>
    <% }); %>
  <% } %>

  <%# Flash Info Messages %>
  <% if (typeof info_msg !== 'undefined' && info_msg && info_msg.length > 0) { %>
    <% info_msg.forEach(function(msg) { %>
      <div class="square-toast toast-info" role="alert" title="<%= msg %>">
        <div class="toast-icon-box"><i class="bi bi-info-circle-fill"></i></div>
        <div class="toast-text"><%= formatAlertText(msg) %></div>
        <button type="button" class="toast-close" onclick="dismissSquareToast(this)" aria-label="Close">
          <i class="bi bi-x"></i>
        </button>
      </div>
    <% }); %>
  <% } %>
</div>

<script>
  function dismissSquareToast(btn) {
    const toast = btn.closest('.square-toast');
    if (!toast) return;
    toast.style.animation = 'squareToastOut 0.22s forwards';
    setTimeout(() => {
      toast.remove();
    }, 220);
  }

  // Auto-dismiss bottom square toasts after 4.5 seconds
  document.addEventListener('DOMContentLoaded', function() {
    const toasts = document.querySelectorAll('.square-toast');
    toasts.forEach((toast, idx) => {
      setTimeout(() => {
        if (toast && toast.parentNode) {
          toast.style.animation = 'squareToastOut 0.25s forwards';
          setTimeout(() => toast.remove(), 250);
        }
      }, 4500 + (idx * 500));
    });
  });
</script>
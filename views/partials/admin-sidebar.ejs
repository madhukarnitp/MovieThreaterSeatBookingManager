<aside class="col-lg-3 col-xl-2 bg-[#0B0D13] border-end border-[#1E2433] p-3.5 min-vh-100 d-flex flex-column shadow-2xl relative select-none">
  <!-- Top cyber accent line -->
  <div class="absolute top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-[#6366F1] to-[#00F0FF]"></div>

  <!-- Brand Header -->
  <div class="d-flex align-items-center justify-between mb-4 px-2 pt-2">
    <div class="d-flex align-items-center gap-2.5">
      <div class="w-9 h-9 rounded-xl flex items-center justify-center bg-gradient-to-br from-[#6366F1] to-[#4338CA] text-white shadow-lg shadow-indigo-500/25 border border-indigo-400/30">
        <i class="bi bi-cpu-fill text-base"></i>
      </div>
      <div>
        <div class="font-extrabold text-white text-base tracking-tight flex items-center gap-1.5 font-sans">
          Cine<span class="text-[#00F0FF]">Ops</span>
          <span class="text-[9px] font-mono px-1.5 py-0.2 bg-[#1E2433] text-indigo-300 rounded border border-indigo-500/20">v2.4</span>
        </div>
        <div class="text-[#64748B] text-[10px] font-mono tracking-wider uppercase">Engineering Suite</div>
      </div>
    </div>
  </div>

  <!-- System Status Pulse -->
  <div class="mx-2 mb-3 px-2.5 py-1.5 rounded-lg bg-[#11141D] border border-[#1E2433] d-flex align-items-center justify-between text-[11px] font-mono text-slate-400">
    <span class="d-flex align-items-center gap-1.5">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
      </span>
      <span>Cluster: Online</span>
    </span>
    <span class="text-indigo-400 font-semibold">99.98%</span>
  </div>

  <!-- Admin User Pill -->
  <% if (typeof admin !== 'undefined' && admin) { %>
    <div class="p-2.5 mb-3 bg-[#131722] rounded-xl border border-[#1E2433] d-flex align-items-center gap-2.5 shadow-sm">
      <div class="w-8 h-8 rounded-lg bg-indigo-500/15 text-indigo-400 flex items-center justify-center font-bold border border-indigo-500/20">
        <i class="bi bi-person-badge"></i>
      </div>
      <div class="overflow-hidden flex-1">
        <div class="text-slate-100 text-xs font-semibold truncate"><%= admin.fullName %></div>
        <div class="flex items-center gap-1.5 mt-0.5">
          <span class="inline-flex items-center px-1.5 py-0.2 rounded text-[9px] font-mono font-bold uppercase tracking-wider bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
            <%= admin.role %>
          </span>
          <span class="text-[10px] text-slate-500 font-mono">SYS-ADMIN</span>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Navigation Links -->
  <div class="nav flex-column nav-pills gap-1 mb-auto overflow-y-auto pr-1">
    <a href="/admin/dashboard" class="nav-link rounded-xl px-3 py-2 text-xs font-medium transition-all duration-200 d-flex align-items-center justify-between <%= typeof activePage !== 'undefined' && activePage === 'admin-dashboard' ? 'active bg-gradient-to-r from-indigo-600 to-indigo-700 text-white font-semibold shadow-lg shadow-indigo-600/30 border border-indigo-400/30' : 'text-slate-300 hover:text-white hover:bg-[#131722] border border-transparent' %>">
      <span><i class="bi bi-grid-1x2-fill me-2.5 <%= typeof activePage !== 'undefined' && activePage === 'admin-dashboard' ? 'text-white' : 'text-indigo-400' %>"></i> Overview</span>
      <span class="text-[10px] font-mono text-slate-400">Ctrl+D</span>
    </a>

    <div class="text-[#64748B] font-mono font-bold uppercase px-3 pt-3 pb-1 text-[10px] tracking-wider flex items-center justify-between">
      <span>Infrastructure &amp; Assets</span>
      <i class="bi bi-hdd-network text-xs"></i>
    </div>

    <a href="/admin/movies" class="nav-link rounded-xl px-3 py-2 text-xs font-medium transition-all duration-200 <%= typeof activePage !== 'undefined' && activePage === 'admin-movies' ? 'active bg-gradient-to-r from-indigo-600 to-indigo-700 text-white font-semibold shadow-lg shadow-indigo-600/30 border border-indigo-400/30' : 'text-slate-300 hover:text-white hover:bg-[#131722] border border-transparent' %>">
      <i class="bi bi-film me-2.5 text-cyan-400"></i> Movies
    </a>

    <a href="/admin/genres" class="nav-link rounded-xl px-3 py-2 text-xs font-medium transition-all duration-200 <%= typeof activePage !== 'undefined' && activePage === 'admin-genres' ? 'active bg-gradient-to-r from-indigo-600 to-indigo-700 text-white font-semibold shadow-lg shadow-indigo-600/30 border border-indigo-400/30' : 'text-slate-300 hover:text-white hover:bg-[#131722] border border-transparent' %>">
      <i class="bi bi-tags me-2.5 text-cyan-400"></i> Genres
    </a>

    <a href="/admin/theaters" class="nav-link rounded-xl px-3 py-2 text-xs font-medium transition-all duration-200 <%= typeof activePage !== 'undefined' && activePage === 'admin-theaters' ? 'active bg-gradient-to-r from-indigo-600 to-indigo-700 text-white font-semibold shadow-lg shadow-indigo-600/30 border border-indigo-400/30' : 'text-slate-300 hover:text-white hover:bg-[#131722] border border-transparent' %>">
      <i class="bi bi-buildings me-2.5 text-indigo-400"></i> Theaters
    </a>

    <a href="/admin/screens" class="nav-link rounded-xl px-3 py-2 text-xs font-medium transition-all duration-200 <%= typeof activePage !== 'undefined' && activePage === 'admin-screens' ? 'active bg-gradient-to-r from-indigo-600 to-indigo-700 text-white font-semibold shadow-lg shadow-indigo-600/30 border border-indigo-400/30' : 'text-slate-300 hover:text-white hover:bg-[#131722] border border-transparent' %>">
      <i class="bi bi-display me-2.5 text-indigo-400"></i> Screens
    </a>

    <a href="/admin/seats" class="nav-link rounded-xl px-3 py-2 text-xs font-medium transition-all duration-200 <%= typeof activePage !== 'undefined' && activePage === 'admin-seats' ? 'active bg-gradient-to-r from-indigo-600 to-indigo-700 text-white font-semibold shadow-lg shadow-indigo-600/30 border border-indigo-400/30' : 'text-slate-300 hover:text-white hover:bg-[#131722] border border-transparent' %>">
      <i class="bi bi-grid-3x3 me-2.5 text-cyan-400"></i> Seat Matrix
    </a>

    <div class="text-[#64748B] font-mono font-bold uppercase px-3 pt-3 pb-1 text-[10px] tracking-wider flex items-center justify-between">
      <span>Runtime Operations</span>
      <i class="bi bi-cpu text-xs"></i>
    </div>

    <a href="/admin/showtimes" class="nav-link rounded-xl px-3 py-2 text-xs font-medium transition-all duration-200 <%= typeof activePage !== 'undefined' && activePage === 'admin-showtimes' ? 'active bg-gradient-to-r from-indigo-600 to-indigo-700 text-white font-semibold shadow-lg shadow-indigo-600/30 border border-indigo-400/30' : 'text-slate-300 hover:text-white hover:bg-[#131722] border border-transparent' %>">
      <i class="bi bi-calendar-event me-2.5 text-amber-400"></i> Showtimes
    </a>

    <a href="/admin/bookings" class="nav-link rounded-xl px-3 py-2 text-xs font-medium transition-all duration-200 <%= typeof activePage !== 'undefined' && activePage === 'admin-bookings' ? 'active bg-gradient-to-r from-indigo-600 to-indigo-700 text-white font-semibold shadow-lg shadow-indigo-600/30 border border-indigo-400/30' : 'text-slate-300 hover:text-white hover:bg-[#131722] border border-transparent' %>">
      <i class="bi bi-ticket-perforated me-2.5 text-emerald-400"></i> Bookings
    </a>

    <a href="/admin/customers" class="nav-link rounded-xl px-3 py-2 text-xs font-medium transition-all duration-200 <%= typeof activePage !== 'undefined' && activePage === 'admin-customers' ? 'active bg-gradient-to-r from-indigo-600 to-indigo-700 text-white font-semibold shadow-lg shadow-indigo-600/30 border border-indigo-400/30' : 'text-slate-300 hover:text-white hover:bg-[#131722] border border-transparent' %>">
      <i class="bi bi-people me-2.5 text-indigo-400"></i> Customers
    </a>

    <a href="/admin/payments" class="nav-link rounded-xl px-3 py-2 text-xs font-medium transition-all duration-200 <%= typeof activePage !== 'undefined' && activePage === 'admin-payments' ? 'active bg-gradient-to-r from-indigo-600 to-indigo-700 text-white font-semibold shadow-lg shadow-indigo-600/30 border border-indigo-400/30' : 'text-slate-300 hover:text-white hover:bg-[#131722] border border-transparent' %>">
      <i class="bi bi-credit-card me-2.5 text-emerald-400"></i> Payments
    </a>

    <a href="/admin/tickets" class="nav-link rounded-xl px-3 py-2 text-xs font-medium transition-all duration-200 <%= typeof activePage !== 'undefined' && activePage === 'admin-tickets' ? 'active bg-gradient-to-r from-indigo-600 to-indigo-700 text-white font-semibold shadow-lg shadow-indigo-600/30 border border-indigo-400/30' : 'text-slate-300 hover:text-white hover:bg-[#131722] border border-transparent' %>">
      <i class="bi bi-upc me-2.5 text-cyan-400"></i> Tickets
    </a>

    <a href="/admin/refunds" class="nav-link rounded-xl px-3 py-2 text-xs font-medium transition-all duration-200 <%= typeof activePage !== 'undefined' && activePage === 'admin-refunds' ? 'active bg-gradient-to-r from-indigo-600 to-indigo-700 text-white font-semibold shadow-lg shadow-indigo-600/30 border border-indigo-400/30' : 'text-slate-300 hover:text-white hover:bg-[#131722] border border-transparent' %>">
      <i class="bi bi-arrow-counterclockwise me-2.5 text-rose-400"></i> Refunds
    </a>

    <a href="/admin/reports" class="nav-link rounded-xl px-3 py-2 text-xs font-medium transition-all duration-200 <%= typeof activePage !== 'undefined' && activePage === 'admin-reports' ? 'active bg-gradient-to-r from-indigo-600 to-indigo-700 text-white font-semibold shadow-lg shadow-indigo-600/30 border border-indigo-400/30' : 'text-slate-300 hover:text-white hover:bg-[#131722] border border-transparent' %>">
      <i class="bi bi-bar-chart-line-fill me-2.5 text-violet-400"></i> Telemetry &amp; Reports
    </a>

    <a href="/admin/tickets/verify" class="nav-link rounded-xl px-3 py-2 text-xs font-medium transition-all duration-200 <%= typeof activePage !== 'undefined' && activePage === 'admin-verify-ticket' ? 'active bg-gradient-to-r from-indigo-600 to-indigo-700 text-white font-semibold shadow-lg shadow-indigo-600/30 border border-indigo-400/30' : 'text-slate-300 hover:text-white hover:bg-[#131722] border border-transparent' %>">
      <i class="bi bi-qr-code-scan me-2.5 text-cyan-400"></i> Scanner Console
    </a>
  </div>

  <!-- Sidebar Footer -->
  <div class="pt-3 border-top border-[#1E2433] mt-3">
    <a href="/" class="btn btn-outline-secondary btn-sm w-100 mb-2 rounded-xl text-slate-300 hover:text-white border-[#1E2433] hover:bg-[#131722] transition-all text-xs font-medium">
      <i class="bi bi-box-arrow-up-right me-1 text-slate-400"></i> Client Storefront
    </a>
    <form action="/auth/admin/logout" method="POST">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <button type="submit" class="btn btn-outline-danger btn-sm w-100 rounded-xl transition-all border-rose-500/30 text-rose-400 hover:bg-rose-500/20 text-xs font-medium">
        <i class="bi bi-power me-1"></i> Terminate Session
      </button>
    </form>
  </div>
</aside>
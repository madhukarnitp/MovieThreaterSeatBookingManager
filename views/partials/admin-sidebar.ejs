<aside class="col-lg-3 col-xl-2 bg-dark bg-opacity-75 border-end border-secondary border-opacity-25 p-3 min-vh-100 d-flex flex-column">
  <!-- Brand Header -->
  <div class="d-flex align-items-center gap-2 mb-3 pb-3 border-bottom border-secondary border-opacity-25">
    <span class="badge bg-warning text-dark p-2 rounded-3"><i class="bi bi-film fs-5"></i></span>
    <div>
      <div class="fw-bold text-white small">Cine<span class="text-warning">Seat</span> Admin</div>
      <div class="text-secondary" style="font-size: 0.75rem;">Theater Management</div>
    </div>
  </div>

  <!-- Admin User Pill -->
  <% if (typeof admin !== 'undefined' && admin) { %>
    <div class="p-2 mb-3 bg-secondary bg-opacity-10 rounded-3 border border-secondary border-opacity-25 d-flex align-items-center gap-2">
      <div class="rounded-circle bg-danger bg-opacity-25 text-danger d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
        <i class="bi bi-person-badge"></i>
      </div>
      <div class="overflow-hidden">
        <div class="text-white small fw-semibold text-truncate"><%= admin.fullName %></div>
        <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-25" style="font-size: 0.65rem;">ADMINISTRATOR</span>
      </div>
    </div>
  <% } %>

  <!-- Navigation Links -->
  <div class="nav flex-column nav-pills gap-1 mb-auto">
    <div class="text-secondary small fw-bold text-uppercase px-2 pt-1 pb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">System Overview</div>
    <a href="/admin/dashboard" class="nav-link rounded-3 px-3 py-2 small <%= typeof activePage !== 'undefined' && activePage === 'admin-dashboard' ? 'active bg-danger text-white fw-bold' : 'text-light' %>">
      <i class="bi bi-speedometer2 me-2"></i> Dashboard
    </a>

    <div class="text-secondary small fw-bold text-uppercase px-2 pt-3 pb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Relational Tables (CRUD)</div>
    <a href="/admin/movies" class="nav-link rounded-3 px-3 py-2 small <%= typeof activePage !== 'undefined' && activePage === 'admin-movies' ? 'active bg-danger text-white fw-bold' : 'text-light' %>">
      <i class="bi bi-film me-2 text-warning"></i> Movies
    </a>
    <a href="/admin/theaters" class="nav-link rounded-3 px-3 py-2 small <%= typeof activePage !== 'undefined' && activePage === 'admin-theaters' ? 'active bg-danger text-white fw-bold' : 'text-light' %>">
      <i class="bi bi-buildings me-2 text-info"></i> Theaters
    </a>
    <a href="/admin/screens" class="nav-link rounded-3 px-3 py-2 small <%= typeof activePage !== 'undefined' && activePage === 'admin-screens' ? 'active bg-danger text-white fw-bold' : 'text-light' %>">
      <i class="bi bi-display me-2 text-primary"></i> Screens
    </a>
    <a href="/admin/seats" class="nav-link rounded-3 px-3 py-2 small <%= typeof activePage !== 'undefined' && activePage === 'admin-seats' ? 'active bg-danger text-white fw-bold' : 'text-light' %>">
      <i class="bi bi-grid-3x3 me-2 text-info"></i> Seat Matrix
    </a>
    <a href="/admin/showtimes" class="nav-link rounded-3 px-3 py-2 small <%= typeof activePage !== 'undefined' && activePage === 'admin-showtimes' ? 'active bg-danger text-white fw-bold' : 'text-light' %>">
      <i class="bi bi-calendar-event me-2 text-warning"></i> Showtimes
    </a>

    <div class="text-secondary small fw-bold text-uppercase px-2 pt-3 pb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Transactions &amp; Audit</div>
    <a href="/admin/bookings" class="nav-link rounded-3 px-3 py-2 small <%= typeof activePage !== 'undefined' && activePage === 'admin-bookings' ? 'active bg-danger text-white fw-bold' : 'text-light' %>">
      <i class="bi bi-ticket-perforated me-2 text-success"></i> Bookings
    </a>
    <a href="/admin/payments" class="nav-link rounded-3 px-3 py-2 small <%= typeof activePage !== 'undefined' && activePage === 'admin-payments' ? 'active bg-danger text-white fw-bold' : 'text-light' %>">
      <i class="bi bi-credit-card me-2 text-success"></i> Payments Audit
    </a>
  </div>

  <!-- Sidebar Footer -->
  <div class="pt-3 border-top border-secondary border-opacity-25 mt-3">
    <form action="/auth/logout" method="POST">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <button type="submit" class="btn btn-outline-danger btn-sm w-100 rounded-pill">
        <i class="bi bi-box-arrow-right me-1"></i> Sign Out
      </button>
    </form>
  </div>
</aside>
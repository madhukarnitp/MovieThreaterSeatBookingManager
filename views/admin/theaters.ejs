<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="row">
    <%- include('../partials/admin-sidebar') %>

    <div class="col-lg-9 col-xl-10 p-4 p-md-5">
      <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary-subtle">
        <div>
          <h2 class="fw-bold text-white mb-0">Theater Complexes Management</h2>
          <p class="text-secondary small mb-0">Configure theater physical addresses, contact information, and auditoriums</p>
        </div>
        <button type="button" class="btn btn-warning rounded-pill px-4 fw-semibold text-dark" data-bs-toggle="modal" data-bs-target="#addTheaterModal">
          <i class="bi bi-plus-circle-fill me-1"></i> Add Theater
        </button>
      </div>

      <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle rounded-4 p-4 shadow-sm">
        <div class="table-responsive">
          <table class="table table-dark table-hover align-middle mb-0">
            <thead>
              <tr class="text-secondary small">
                <th>THEATER NAME</th>
                <th>CITY &amp; STATE</th>
                <th>ADDRESS &amp; PIN</th>
                <th>PHONE</th>
                <th>SCREENS</th>
                <th>CAPACITY</th>
                <th>STATUS</th>
                <th class="text-end">ACTIONS</th>
              </tr>
            </thead>
            <tbody>
              <% if (theaters && theaters.length > 0) { %>
                <% theaters.forEach(function(t) { %>
                  <tr>
                    <td>
                      <div class="fw-bold text-white"><%= t.name %></div>
                      <div class="small text-secondary">ID: #<%= t.theater_id %></div>
                    </td>
                    <td>
                      <div class="text-light"><%= t.city %></div>
                      <div class="small text-secondary"><%= t.state %></div>
                    </td>
                    <td class="small text-secondary" style="max-width: 200px;">
                      <%= t.address %> <% if (t.pincode) { %>- <%= t.pincode %><% } %>
                    </td>
                    <td class="small"><%= t.phone || 'N/A' %></td>
                    <td><span class="badge text-bg-secondary"><%= t.screen_count %> Screen(s)</span></td>
                    <td class="fw-semibold"><%= t.total_theater_capacity %> seats</td>
                    <td>
                      <% if (t.is_active) { %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                      <% } else { %>
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactive</span>
                      <% } %>
                    </td>
                    <td class="text-end">
                      <div class="btn-group btn-group-sm">
                        <a href="/admin/screens?theater_id Colonial=<%= t.theater_id %>" class="btn btn-outline-info" title="View Screens">
                          <i class="bi bi-display"></i>
                        </a>
                        <button type="button" class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#editTheaterModal<%= t.theater_id %>" title="Edit Theater">
                          <i class="bi bi-pencil-square"></i>
                        </button>
                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteTheaterModal<%= t.theater_id %>" title="Delete or Deactivate">
                          <i class="bi bi-trash"></i>
                        </button>
                      </div>
                    </td>
                  </tr>

                  <!-- Edit Theater Modal -->
                  <div class="modal fade" id="editTheaterModal<%= t.theater_id %>" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-lg modal-dialog-centered">
                      <div class="modal-content bg-dark border border-secondary-subtle text-light">
                        <form action="/admin/theaters/<%= t.theater_id %>/edit" method="POST">
                          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                          <div class="modal-header border-secondary-subtle">
                            <h5 class="modal-title fw-bold">Edit Theater: <%= t.name %></h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                          </div>
                          <div class="modal-body p-4">
                            <div class="row g-3">
                              <div class="col-md-6">
                                <label class="form-label small fw-semibold">Theater Name <span class="text-danger">*</span></label>
                                <input type="text" name="name" class="form-control bg-black text-light border-secondary-subtle" value="<%= t.name %>" required>
                              </div>
                              <div class="col-md-3">
                                <label class="form-label small fw-semibold">City <span class="text-danger">*</span></label>
                                <input type="text" name="city" class="form-control bg-black text-light border-secondary-subtle" value="<%= t.city %>" required>
                              </div>
                              <div class="col-md-3">
                                <label class="form-label small fw-semibold">State <span class="text-danger">*</span></label>
                                <input type="text" name="state" class="form-control bg-black text-light border-secondary-subtle" value="<%= t.state %>" required>
                              </div>
                              <div class="col-md-8">
                                <label class="form-label small fw-semibold">Street Address <span class="text-danger">*</span></label>
                                <input type="text" name="address" class="form-control bg-black text-light border-secondary-subtle" value="<%= t.address %>" required>
                              </div>
                              <div class="col-md-4">
                                <label class="form-label small fw-semibold">Postal Pincode</label>
                                <input type="text" name="pincode" class="form-control bg-black text-light border-secondary-subtle" value="<%= t.pincode || '' %>">
                              </div>
                              <div class="col-md-6">
                                <label class="form-label small fw-semibold">Phone Contact</label>
                                <input type="text" name="phone" class="form-control bg-black text-light border-secondary-subtle" value="<%= t.phone || '' %>">
                              </div>
                              <div class="col-md-6">
                                <label class="form-label small fw-semibold">Active Status</label>
                                <select name="is_active" class="form-select bg-black text-light border-secondary-subtle">
                                  <option value="1" <%= t.is_active ? 'selected' : '' %>>Active &bull; Operational</option>
                                  <option value="0" <%= !t.is_active ? 'selected' : '' %>>Inactive &bull; Closed</option>
                                </select>
                              </div>
                            </div>
                          </div>
                          <div class="modal-footer border-secondary-subtle">
                            <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-warning rounded-pill fw-semibold">Update Theater</button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>

                  <!-- Delete Modal -->
                  <div class="modal fade" id="deleteTheaterModal<%= t.theater_id %>" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                      <div class="modal-content bg-dark border border-danger-subtle text-light">
                        <form action="/admin/theaters/<%= t.theater_id %>/delete" method="POST">
                          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                          <div class="modal-header border-danger-subtle">
                            <h5 class="modal-title fw-bold text-danger">Delete or Deactivate Theater</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                          </div>
                          <div class="modal-body p-4">
                            <p>Are you sure you want to remove <strong><%= t.name %></strong>?</p>
                            <p class="small text-secondary mb-0">If this theater has associated screens, it will be marked as inactive rather than deleting child records.</p>
                          </div>
                          <div class="modal-footer border-secondary-subtle">
                            <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger rounded-pill fw-semibold">Confirm</button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Add Theater Modal -->
<div class="modal fade" id="addTheaterModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content bg-dark border border-secondary-subtle text-light">
      <form action="/admin/theaters" method="POST">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <div class="modal-header border-secondary-subtle">
          <h5 class="modal-title fw-bold"><i class="bi bi-buildings-fill me-2 text-warning"></i>Add New Theater</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Theater Complex Name <span class="text-danger">*</span></label>
              <input type="text" name="name" class="form-control bg-black text-light border-secondary-subtle" placeholder="e.g. CineGrand Phoenix" required>
            </div>
            <div class="col-md-3">
              <label class="form-label small fw-semibold">City <span class="text-danger">*</span></label>
              <input type="text" name="city" class="form-control bg-black text-light border-secondary-subtle" placeholder="e.g. Mumbai" required>
            </div>
            <div class="col-md-3">
              <label class="form-label small fw-semibold">State <span class="text-danger">*</span></label>
              <input type="text" name="state" class="form-control bg-black text-light border-secondary-subtle" placeholder="e.g. Maharashtra" required>
            </div>
            <div class="col-md-8">
              <label class="form-label small fw-semibold">Street Address <span class="text-danger">*</span></label>
              <input type="text" name="address" class="form-control bg-black text-light border-secondary-subtle" placeholder="Mall / Street address" required>
            </div>
            <div class="col-md-4">
              <label class="form-label small fw-semibold">Postal Pincode</label>
              <input type="text" name="pincode" class="form-control bg-black text-light border-secondary-subtle" placeholder="e.g. 400050">
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Telephone Contact</label>
              <input type="text" name="phone" class="form-control bg-black text-light border-secondary-subtle" placeholder="+91 22 2640 1234">
            </div>
          </div>
        </div>
        <div class="modal-footer border-secondary-subtle">
          <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-warning rounded-pill fw-semibold text-dark">Save Theater</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="row">
    <%- include('../partials/admin-sidebar') %>

    <div class="col-lg-9 col-xl-10 p-4 p-md-5">
      <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary-subtle">
        <div>
          <h2 class="fw-bold text-white mb-0">Movie Genres Management</h2>
          <p class="text-secondary small mb-0">Create and maintain genre classifications linked to movie catalogs</p>
        </div>
        <button type="button" class="btn btn-warning rounded-pill px-4 fw-semibold text-dark" data-bs-toggle="modal" data-bs-target="#addGenreModal">
          <i class="bi bi-plus-circle-fill me-1"></i> Add Genre
        </button>
      </div>

      <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle rounded-4 p-4 shadow-sm">
        <div class="table-responsive">
          <table class="table table-dark table-hover align-middle mb-0">
            <thead>
              <tr class="text-secondary small">
                <th>#</th>
                <th>GENRE NAME</th>
                <th>SLUG</th>
                <th>LINKED MOVIES</th>
                <th>CREATED DATE</th>
                <th class="text-end">ACTIONS</th>
              </tr>
            </thead>
            <tbody>
              <% if (genres && genres.length > 0) { %>
                <% genres.forEach(function(g, idx) { %>
                  <tr>
                    <td><%= idx + 1 %></td>
                    <td class="fw-bold text-white"><%= g.name %></td>
                    <td><code><%= g.slug %></code></td>
                    <td><span class="badge text-bg-secondary"><%= g.movie_count %> movie(s)</span></td>
                    <td class="small text-secondary"><%= new Date(g.created_at).toLocaleDateString() %></td>
                    <td class="text-end">
                      <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#editGenreModal<%= g.genre_id %>">
                          <i class="bi bi-pencil-square"></i>
                        </button>
                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteGenreModal<%= g.genre_id %>">
                          <i class="bi bi-trash"></i>
                        </button>
                      </div>
                    </td>
                  </tr>

                  <!-- Edit Modal -->
                  <div class="modal fade" id="editGenreModal<%= g.genre_id %>" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                      <div class="modal-content bg-dark border border-secondary-subtle text-light">
                        <form action="/admin/genres/<%= g.genre_id %>/edit" method="POST">
                          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                          <div class="modal-header border-secondary-subtle">
                            <h5 class="modal-title fw-bold">Edit Genre</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                          </div>
                          <div class="modal-body p-4">
                            <div class="mb-3">
                              <label class="form-label small fw-semibold">Genre Name <span class="text-danger">*</span></label>
                              <input type="text" name="name" class="form-control bg-black text-light border-secondary-subtle" value="<%= g.name %>" required>
                            </div>
                            <div class="mb-3">
                              <label class="form-label small fw-semibold">Slug (Optional)</label>
                              <input type="text" name="slug" class="form-control bg-black text-light border-secondary-subtle" value="<%= g.slug %>">
                            </div>
                          </div>
                          <div class="modal-footer border-secondary-subtle">
                            <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-warning rounded-pill fw-semibold">Update Genre</button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>

                  <!-- Delete Modal -->
                  <div class="modal fade" id="deleteGenreModal<%= g.genre_id %>" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                      <div class="modal-content bg-dark border border-danger-subtle text-light">
                        <form action="/admin/genres/<%= g.genre_id %>/delete" method="POST">
                          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                          <div class="modal-header border-danger-subtle">
                            <h5 class="modal-title fw-bold text-danger">Delete Genre</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                          </div>
                          <div class="modal-body p-4">
                            <p>Are you sure you want to delete genre <strong><%= g.name %></strong>?</p>
                          </div>
                          <div class="modal-footer border-secondary-subtle">
                            <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger rounded-pill fw-semibold">Delete</button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Add Genre Modal -->
<div class="modal fade" id="addGenreModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content bg-dark border border-secondary-subtle text-light">
      <form action="/admin/genres" method="POST">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <div class="modal-header border-secondary-subtle">
          <h5 class="modal-title fw-bold"><i class="bi bi-tag-fill me-2 text-warning"></i>Add New Genre</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4">
          <div class="mb-3">
            <label class="form-label small fw-semibold">Genre Name <span class="text-danger">*</span></label>
            <input type="text" name="name" class="form-control bg-black text-light border-secondary-subtle" placeholder="e.g. Psychological Thriller" required>
          </div>
          <div class="mb-3">
            <label class="form-label small fw-semibold">Custom Slug (Optional)</label>
            <input type="text" name="slug" class="form-control bg-black text-light border-secondary-subtle" placeholder="e.g. psychological-thriller">
          </div>
        </div>
        <div class="modal-footer border-secondary-subtle">
          <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-warning rounded-pill fw-semibold text-dark">Save Genre</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

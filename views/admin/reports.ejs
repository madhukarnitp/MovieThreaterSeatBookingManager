<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="row">
    <!-- Admin Sidebar Partial -->
    <%- include('../partials/admin-sidebar') %>

    <!-- Main Admin Content Area -->
    <div class="col-lg-9 col-xl-10 p-4 p-md-5">
      <!-- Title Bar -->
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary-subtle gap-3">
        <div>
          <h2 class="fw-bold text-white mb-0">
            <i class="bi bi-bar-chart-line-fill text-warning me-2"></i>Cinema Analytics &amp; Reports
          </h2>
          <p class="text-secondary small mb-0">Aggregated database reporting for revenue, admissions, and capacity utilization</p>
        </div>
        <div class="d-flex align-items-center gap-2">
          <!-- Date Filter Dropdown -->
          <form action="/admin/reports" method="GET" class="d-flex align-items-center gap-2">
            <label class="text-secondary small fw-semibold text-nowrap">Filter Window:</label>
            <select name="days" class="form-select form-select-sm bg-dark border-secondary-subtle text-white" onchange="this.form.submit()">
              <% const curDays = typeof selectedDays !== 'undefined' ? Number(selectedDays) : 14; %>
              <option value="7" <%= curDays === 7 ? 'selected' : '' %>>Past 7 Days</option>
              <option value="14" <%= curDays === 14 ? 'selected' : '' %>>Past 14 Days</option>
              <option value="30" <%= curDays === 30 ? 'selected' : '' %>>Past 30 Days</option>
              <option value="90" <%= curDays === 90 ? 'selected' : '' %>>Past 90 Days</option>
            </select>
          </form>
          <button onclick="window.print()" class="btn btn-outline-secondary btn-sm rounded-pill text-light">
            <i class="bi bi-printer me-1"></i> Print Report
          </button>
        </div>
      </div>

      <!-- Quick KPI Strip -->
      <div class="row g-3 mb-4">
        <div class="col-md-3">
          <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle p-3 rounded-4">
            <span class="text-secondary small text-uppercase">Confirmed Revenue</span>
            <div class="fs-4 fw-bold text-success font-monospace mt-1">₹<%= metrics.totalSuccessfulRevenue.toFixed(2) %></div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle p-3 rounded-4">
            <span class="text-secondary small text-uppercase">Confirmed Bookings</span>
            <div class="fs-4 fw-bold text-white font-monospace mt-1"><%= metrics.confirmedBookings %></div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle p-3 rounded-4">
            <span class="text-secondary small text-uppercase">Active Customers</span>
            <div class="fs-4 fw-bold text-info font-monospace mt-1"><%= metrics.totalCustomers %></div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle p-3 rounded-4">
            <span class="text-secondary small text-uppercase">Processed Refunds</span>
            <div class="fs-4 fw-bold text-danger font-monospace mt-1">₹<%= metrics.totalRefunds.toFixed(2) %></div>
          </div>
        </div>
      </div>

      <!-- REPORT 1 & 2: Daily Trends & Monthly Revenue Charts -->
      <div class="row g-4 mb-4">
        <!-- Daily Booking & Revenue Trend Chart -->
        <div class="col-lg-8">
          <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle rounded-4 p-4 shadow-sm h-100">
            <h5 class="fw-bold text-white mb-3">
              <i class="bi bi-graph-up text-warning me-2"></i>Daily Booking &amp; Revenue Trends
            </h5>
            <div style="height: 300px; position: relative;">
              <canvas id="dailyReportsChart"></canvas>
            </div>
          </div>
        </div>

        <!-- Monthly Breakdown Table -->
        <div class="col-lg-4">
          <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle rounded-4 p-4 shadow-sm h-100">
            <h5 class="fw-bold text-white mb-3">
              <i class="bi bi-calendar3 text-warning me-2"></i>Monthly Revenue
            </h5>
            <div class="table-responsive">
              <table class="table table-dark table-sm align-middle small mb-0">
                <thead>
                  <tr class="text-secondary">
                    <th>Month</th>
                    <th>Txns</th>
                    <th class="text-end">Revenue</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (monthlyRevenue && monthlyRevenue.length > 0) { %>
                    <% monthlyRevenue.forEach(function(m) { %>
                      <tr>
                        <td class="font-monospace text-light"><%= m.month_key %></td>
                        <td><%= m.successful_transactions %></td>
                        <td class="text-end fw-bold text-success">₹<%= Number(m.monthly_revenue).toFixed(2) %></td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="3" class="text-center text-secondary py-3">No monthly records yet.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- REPORT 3: Movie-wise Revenue Breakdown -->
      <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle rounded-4 p-4 mb-4 shadow-sm">
        <h5 class="fw-bold text-white mb-3">
          <i class="bi bi-film text-warning me-2"></i>Movie-wise Revenue &amp; Ticket Sales
        </h5>
        <div class="table-responsive">
          <table class="table table-dark table-hover align-middle mb-0">
            <thead>
              <tr class="text-secondary small">
                <th>Movie Title</th>
                <th>Certification</th>
                <th>Language</th>
                <th>Bookings</th>
                <th>Tickets Sold</th>
                <th class="text-end">Total Gross Revenue</th>
              </tr>
            </thead>
            <tbody>
              <% if (movieRevenue && movieRevenue.length > 0) { %>
                <% movieRevenue.forEach(function(row) { %>
                  <tr>
                    <td class="fw-semibold text-white"><%= row.movie_title %></td>
                    <td><span class="badge bg-secondary-subtle text-light"><%= row.certification %></span></td>
                    <td><%= row.language %></td>
                    <td class="font-monospace"><%= row.confirmed_bookings %></td>
                    <td class="font-monospace"><%= row.tickets_sold %></td>
                    <td class="text-end fw-bold text-warning font-monospace">₹<%= Number(row.total_revenue).toFixed(2) %></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="text-center text-secondary py-4">No movie sales recorded.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- REPORT 4: Theater-wise Revenue Breakdown -->
      <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle rounded-4 p-4 mb-4 shadow-sm">
        <h5 class="fw-bold text-white mb-3">
          <i class="bi bi-buildings text-warning me-2"></i>Theater-wise Performance &amp; Revenue
        </h5>
        <div class="table-responsive">
          <table class="table table-dark table-hover align-middle mb-0">
            <thead>
              <tr class="text-secondary small">
                <th>Theater Complex</th>
                <th>City</th>
                <th>Active Screens</th>
                <th>Bookings</th>
                <th>Tickets Sold</th>
                <th class="text-end">Total Box Office</th>
              </tr>
            </thead>
            <tbody>
              <% if (theaterRevenue && theaterRevenue.length > 0) { %>
                <% theaterRevenue.forEach(function(t) { %>
                  <tr>
                    <td class="fw-semibold text-white"><%= t.theater_name %></td>
                    <td><%= t.city %></td>
                    <td><%= t.total_screens %></td>
                    <td class="font-monospace"><%= t.confirmed_bookings %></td>
                    <td class="font-monospace"><%= t.tickets_sold %></td>
                    <td class="text-end fw-bold text-success font-monospace">₹<%= Number(t.total_revenue).toFixed(2) %></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="text-center text-secondary py-4">No theater sales recorded.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- REPORT 5 & 6: Most Popular Movies & Showtimes -->
      <div class="row g-4">
        <!-- Most Popular Movies -->
        <div class="col-lg-6">
          <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle rounded-4 p-4 h-100 shadow-sm">
            <h5 class="fw-bold text-white mb-3">
              <i class="bi bi-trophy text-warning me-2"></i>Most Popular Movies
            </h5>
            <div class="table-responsive">
              <table class="table table-dark table-hover table-sm align-middle small mb-0">
                <thead>
                  <tr class="text-secondary">
                    <th>Rank</th>
                    <th>Movie</th>
                    <th>Tickets</th>
                    <th class="text-end">Gross</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (popularMovies && popularMovies.length > 0) { %>
                    <% popularMovies.forEach(function(m, idx) { %>
                      <tr>
                        <td><span class="badge bg-warning text-dark font-monospace">#<%= idx + 1 %></span></td>
                        <td class="fw-semibold text-white"><%= m.movie_title %></td>
                        <td class="font-monospace"><%= m.total_tickets %></td>
                        <td class="text-end fw-bold text-warning font-monospace">₹<%= Number(m.total_gross).toFixed(2) %></td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="4" class="text-center text-secondary py-3">No sales yet.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Most Booked Showtimes -->
        <div class="col-lg-6">
          <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle rounded-4 p-4 h-100 shadow-sm">
            <h5 class="fw-bold text-white mb-3">
              <i class="bi bi-clock-history text-warning me-2"></i>Most Booked Showtimes
            </h5>
            <div class="table-responsive">
              <table class="table table-dark table-hover table-sm align-middle small mb-0">
                <thead>
                  <tr class="text-secondary">
                    <th>Showtime</th>
                    <th>Screen</th>
                    <th>Occupancy</th>
                    <th class="text-end">Revenue</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (popularShowtimes && popularShowtimes.length > 0) { %>
                    <% popularShowtimes.forEach(function(st) { %>
                      <tr>
                        <td>
                          <div class="fw-semibold text-white"><%= st.movie_title %></div>
                          <div class="text-secondary" style="font-size: 0.7rem;">
                            <%= new Date(st.start_time).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                          </div>
                        </td>
                        <td><%= st.screen_name %></td>
                        <td>
                          <div class="progress bg-dark" style="height: 6px; width: 60px;">
                            <div class="progress-bar bg-warning" role="progressbar" <%- `style="width: ${st.occupancy_rate}%;"` %>></div>
                          </div>
                          <span class="text-secondary" style="font-size: 0.7rem;"><%= st.occupancy_rate %>%</span>
                        </td>
                        <td class="text-end fw-bold text-light font-monospace">₹<%= Number(st.showtime_revenue).toFixed(2) %></td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="4" class="text-center text-secondary py-3">No booked showtimes.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Raw Chart Data for Client Scripts -->
<script id="dailyReportsData" type="application/json"><%- JSON.stringify(dailyBookings || []) %></script>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const ctx = document.getElementById('dailyReportsChart');
    if (!ctx) return;

    const dataEl = document.getElementById('dailyReportsData');
    const rawData = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
    const labels = rawData.map(d => new Date(d.report_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }));
    const revenues = rawData.map(d => Number(d.daily_revenue));
    const bookings = rawData.map(d => Number(d.total_bookings));

    new Chart(ctx, {
      type: 'bar',
      data: {
        labels: labels.length > 0 ? labels : ['No Data'],
        datasets: [
          {
            type: 'bar',
            label: 'Daily Revenue (₹)',
            data: revenues.length > 0 ? revenues : [0],
            backgroundColor: 'rgba(245, 158, 11, 0.7)',
            borderColor: '#f59e0b',
            borderWidth: 1,
            yAxisID: 'y'
          },
          {
            type: 'line',
            label: 'Bookings Count',
            data: bookings.length > 0 ? bookings : [0],
            borderColor: '#10b981',
            backgroundColor: '#10b981',
            borderWidth: 2,
            tension: 0.2,
            yAxisID: 'y1'
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          x: { grid: { color: 'rgba(255, 255, 255, 0.05)' }, ticks: { color: '#94a3b8' } },
          y: {
            position: 'left',
            grid: { color: 'rgba(255, 255, 255, 0.05)' },
            ticks: { color: '#f59e0b', callback: v => '₹' + v }
          },
          y1: {
            position: 'right',
            grid: { drawOnChartArea: false },
            ticks: { color: '#10b981', stepSize: 1 }
          }
        },
        plugins: {
          legend: { labels: { color: '#e2e8f0' } }
        }
      }
    });
  });
</script>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<div class="container-fluid min-vh-100 px-0">
  <div class="row g-0">
    <!-- Admin Sidebar Partial -->
    <%- include('../partials/admin-sidebar') %>

    <!-- Main Admin Content Area -->
    <div class="col-lg-9 col-xl-10 p-4 p-md-5">
      <!-- Dashboard Header -->
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary border-opacity-25 gap-3">
        <div>
          <div class="d-flex align-items-center gap-2">
            <span class="badge bg-danger p-2 rounded-2"><i class="bi bi-speedometer2 fs-6"></i></span>
            <h2 class="fw-bold text-white mb-0">DBMS Operations Dashboard</h2>
          </div>
          <p class="text-secondary small mb-0 mt-1">
            Movie Theater Database Management System &bull; 3rd Semester Laboratory Project
          </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
          <a href="/admin/movies" class="btn btn-outline-warning btn-sm rounded-pill px-3">
            <i class="bi bi-film me-1"></i> Manage Movies
          </a>
          <a href="/admin/showtimes" class="btn btn-outline-info btn-sm rounded-pill px-3">
            <i class="bi bi-calendar-event me-1"></i> Showtimes
          </a>
          <a href="/admin/bookings" class="btn btn-danger btn-sm rounded-pill px-3 fw-semibold">
            <i class="bi bi-ticket-perforated me-1"></i> Audit Bookings
          </a>
        </div>
      </div>

      <!-- DBMS Aggregate Statistics Cards (Row 1) -->
      <div class="row g-3 mb-4">
        <!-- Metric 1: Total Revenue -->
        <div class="col-sm-6 col-xl-3">
          <div class="card bg-secondary bg-opacity-10 border border-secondary border-opacity-25 rounded-4 p-3 shadow-sm h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <span class="text-secondary small fw-bold text-uppercase" style="font-size: 0.75rem;">Total Revenue</span>
              <div class="rounded-circle bg-success bg-opacity-10 text-success p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                <i class="bi bi-currency-rupee"></i>
              </div>
            </div>
            <div class="fs-4 fw-bold text-white mb-1">
              ₹<%= metrics.totalSuccessfulRevenue.toFixed(2) %>
            </div>
            <div class="small text-success d-flex align-items-center gap-1">
              <i class="bi bi-check-circle-fill"></i>
              <span>Payments Table &bull; SUCCESS</span>
            </div>
          </div>
        </div>

        <!-- Metric 2: Total Bookings -->
        <div class="col-sm-6 col-xl-3">
          <div class="card bg-secondary bg-opacity-10 border border-secondary border-opacity-25 rounded-4 p-3 shadow-sm h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <span class="text-secondary small fw-bold text-uppercase" style="font-size: 0.75rem;">Confirmed Bookings</span>
              <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                <i class="bi bi-ticket-perforated"></i>
              </div>
            </div>
            <div class="fs-4 fw-bold text-white mb-1">
              <%= metrics.totalConfirmedBookings %>
            </div>
            <div class="small text-secondary">
              Bookings Table &bull; CONFIRMED
            </div>
          </div>
        </div>

        <!-- Metric 3: Movies in Catalog -->
        <div class="col-sm-6 col-xl-3">
          <div class="card bg-secondary bg-opacity-10 border border-secondary border-opacity-25 rounded-4 p-3 shadow-sm h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <span class="text-secondary small fw-bold text-uppercase" style="font-size: 0.75rem;">Catalog Movies</span>
              <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                <i class="bi bi-film"></i>
              </div>
            </div>
            <div class="fs-4 fw-bold text-white mb-1">
              <%= metrics.activeMovies %>
            </div>
            <div class="small text-warning">
              Movies Table &bull; Active Titles
            </div>
          </div>
        </div>

        <!-- Metric 4: Theaters & Screens -->
        <div class="col-sm-6 col-xl-3">
          <div class="card bg-secondary bg-opacity-10 border border-secondary border-opacity-25 rounded-4 p-3 shadow-sm h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <span class="text-secondary small fw-bold text-uppercase" style="font-size: 0.75rem;">Venues &amp; Screens</span>
              <div class="rounded-circle bg-info bg-opacity-10 text-info p-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                <i class="bi bi-buildings"></i>
              </div>
            </div>
            <div class="fs-4 fw-bold text-white mb-1">
              <%= metrics.totalTheaters %> <span class="fs-6 fw-normal text-secondary">Venues</span> &bull; <%= metrics.totalScreens %> <span class="fs-6 fw-normal text-secondary">Screens</span>
            </div>
            <div class="small text-info">
              <%= metrics.totalCustomers %> Registered Customers
            </div>
          </div>
        </div>
      </div>

      <!-- Relational Data Tables (Row 2) -->
      <div class="row g-4 mb-4">
        <!-- Recent Bookings Table (Col 8) -->
        <div class="col-lg-8">
          <div class="card bg-secondary bg-opacity-10 border border-secondary border-opacity-25 rounded-4 p-4 shadow-sm h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div>
                <h5 class="fw-bold text-white mb-0">Recent Customer Bookings</h5>
                <p class="text-secondary small mb-0">Transactions joining Users, Bookings, Showtimes, &amp; Movies</p>
              </div>
              <a href="/admin/bookings" class="btn btn-outline-secondary btn-sm rounded-pill text-light px-3">
                View All <i class="bi bi-arrow-right ms-1"></i>
              </a>
            </div>

            <div class="table-responsive">
              <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                  <tr class="text-secondary small">
                    <th>BOOKING REF</th>
                    <th>CUSTOMER</th>
                    <th>MOVIE &amp; VENUE</th>
                    <th>AMOUNT</th>
                    <th>STATUS</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (recentBookings && recentBookings.length > 0) { %>
                    <% recentBookings.forEach(function(b) { %>
                      <tr>
                        <td>
                          <span class="badge text-bg-dark border border-secondary border-opacity-25 font-monospace">
                            <%= b.booking_ref %>
                          </span>
                        </td>
                        <td>
                          <div class="fw-semibold text-white small"><%= b.customer_name %></div>
                          <div class="text-secondary" style="font-size: 0.75rem;"><%= b.customer_email %></div>
                        </td>
                        <td>
                          <div class="text-warning small fw-semibold"><%= b.movie_title %></div>
                          <div class="text-secondary" style="font-size: 0.75rem;"><%= b.theater_name %> &bull; <%= b.screen_name %></div>
                        </td>
                        <td class="fw-bold text-white">
                          ₹<%= parseFloat(b.total_amount).toFixed(2) %>
                        </td>
                        <td>
                          <% if (b.booking_status === 'CONFIRMED') { %>
                            <span class="badge bg-success-subtle text-success border border-success-subtle">CONFIRMED</span>
                          <% } else if (b.booking_status === 'PENDING') { %>
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle">PENDING</span>
                          <% } else { %>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><%= b.booking_status %></span>
                          <% } %>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="5" class="text-center text-secondary py-4">No recent bookings recorded.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Top Performing Movies by Revenue (Col 4) -->
        <div class="col-lg-4">
          <div class="card bg-secondary bg-opacity-10 border border-secondary border-opacity-25 rounded-4 p-4 shadow-sm h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <div>
                <h5 class="fw-bold text-white mb-0">Top Movies</h5>
                <p class="text-secondary small mb-0">Ranked by Settled Revenue</p>
              </div>
              <span class="badge bg-warning text-dark"><i class="bi bi-trophy-fill"></i></span>
            </div>

            <div class="table-responsive">
              <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                  <tr class="text-secondary small">
                    <th>FILM</th>
                    <th class="text-end">SALES</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (topMovies && topMovies.length > 0) { %>
                    <% topMovies.forEach(function(m, idx) { %>
                      <tr>
                        <td>
                          <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-secondary bg-opacity-25 text-secondary rounded-circle" style="width: 22px; height: 22px; font-size: 0.7rem; display: flex; align-items: center; justify-content: center;">
                              <%= idx + 1 %>
                            </span>
                            <div>
                              <div class="fw-semibold text-white small"><%= m.title %></div>
                              <div class="text-secondary" style="font-size: 0.7rem;"><%= m.total_bookings %> booking(s)</div>
                            </div>
                          </div>
                        </td>
                        <td class="text-end fw-bold text-warning">
                          ₹<%= parseFloat(m.revenue || 0).toFixed(2) %>
                        </td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="2" class="text-center text-secondary py-4">No revenue data available.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <!-- Recent Payments Audit (Row 3) -->
      <div class="card bg-secondary bg-opacity-10 border border-secondary border-opacity-25 rounded-4 p-4 shadow-sm mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <div>
            <h5 class="fw-bold text-white mb-0">Recent Payment Transactions</h5>
            <p class="text-secondary small mb-0">Audit logs from Payments table linked to Bookings</p>
          </div>
          <a href="/admin/payments" class="btn btn-outline-secondary btn-sm rounded-pill text-light px-3">
            View All Payments <i class="bi bi-arrow-right ms-1"></i>
          </a>
        </div>

        <div class="table-responsive">
          <table class="table table-dark table-hover align-middle mb-0">
            <thead>
              <tr class="text-secondary small">
                <th>TXN REFERENCE</th>
                <th>BOOKING REF</th>
                <th>CUSTOMER</th>
                <th>METHOD</th>
                <th>AMOUNT</th>
                <th>STATUS</th>
                <th>DATE / TIME</th>
              </tr>
            </thead>
            <tbody>
              <% if (recentPayments && recentPayments.length > 0) { %>
                <% recentPayments.forEach(function(p) { %>
                  <tr>
                    <td>
                      <span class="badge text-bg-dark border border-secondary border-opacity-25 font-monospace">
                        <%= p.transaction_ref %>
                      </span>
                    </td>
                    <td class="text-secondary small"><%= p.booking_ref %></td>
                    <td class="text-white small fw-semibold"><%= p.customer_name %></td>
                    <td>
                      <span class="badge bg-secondary bg-opacity-25 text-light border border-secondary border-opacity-25">
                        <%= p.payment_method %>
                      </span>
                    </td>
                    <td class="fw-bold text-white">₹<%= parseFloat(p.amount).toFixed(2) %></td>
                    <td>
                      <% if (p.payment_status === 'SUCCESS') { %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">SUCCESS</span>
                      <% } else if (p.payment_status === 'PENDING') { %>
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">PENDING</span>
                      <% } else { %>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><%= p.payment_status %></span>
                      <% } %>
                    </td>
                    <td class="text-secondary small">
                      <%= new Date(p.payment_date).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="text-center text-secondary py-4">No payment transactions recorded.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- DBMS Project Notes Card -->
      <div class="alert alert-secondary bg-dark border-secondary border-opacity-25 rounded-4 p-3 mb-0">
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-info-circle-fill text-warning fs-5"></i>
          <div>
            <span class="fw-bold text-white">DBMS Laboratory Project (3rd Semester):</span>
            <span class="text-secondary small ms-1">
              Implements 9 core normalized relational tables (<code>users</code>, <code>theaters</code>, <code>screens</code>, <code>seats</code>, <code>movies</code>, <code>showtimes</code>, <code>bookings</code>, <code>booking_seats</code>, <code>payments</code>) with primary keys, foreign key constraints, <code>ON DELETE CASCADE</code> rules, and ACID transaction semantics.
            </span>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include('../partials/footer') %>
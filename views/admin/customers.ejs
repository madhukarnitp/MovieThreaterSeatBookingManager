<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="row">
    <%- include('../partials/admin-sidebar') %>

    <div class="col-lg-9 col-xl-10 p-4 p-md-5">
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary-subtle gap-3">
        <div>
          <h2 class="fw-bold text-white mb-0">Customer Account Management</h2>
          <p class="text-secondary small mb-0">Review customer registration information, search patrons, and manage account statuses</p>
        </div>
        <!-- Customer Search Form -->
        <form action="/admin/customers" method="GET" class="d-flex gap-2">
          <input 
            type="text" 
            name="search" 
            class="form-control form-control-sm bg-dark border-secondary-subtle text-white rounded-pill px-3" 
            placeholder="Search name, email, phone..." 
            value="<%= typeof search !== 'undefined' ? search : '' %>"
            style="width: 250px;"
          >
          <button type="submit" class="btn btn-warning btn-sm rounded-pill px-3">
            <i class="bi bi-search"></i>
          </button>
          <% if (typeof search !== 'undefined' && search) { %>
            <a href="/admin/customers" class="btn btn-outline-secondary btn-sm rounded-pill px-2" title="Clear search">
              <i class="bi bi-x-lg"></i>
            </a>
          <% } %>
        </form>
      </div>

      <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle rounded-4 p-4 shadow-sm">
        <div class="table-responsive">
          <table class="table table-dark table-hover align-middle mb-0">
            <thead>
              <tr class="text-secondary small">
                <th>#</th>
                <th>CUSTOMER NAME</th>
                <th>EMAIL</th>
                <th>PHONE</th>
                <th>TOTAL BOOKINGS</th>
                <th>TOTAL SPENT</th>
                <th>JOINED DATE</th>
                <th>STATUS</th>
                <th class="text-end">ACTION</th>
              </tr>
            </thead>
            <tbody>
              <% if (customers && customers.length > 0) { %>
                <% customers.forEach(function(c) { %>
                  <tr>
                    <td><%= c.customer_id %></td>
                    <td class="fw-bold text-white"><%= c.full_name %></td>
                    <td><code><%= c.email %></code></td>
                    <td><%= c.phone || 'N/A' %></td>
                    <td><span class="badge text-bg-secondary"><%= c.total_bookings %></span></td>
                    <td class="fw-semibold">₹<%= Number(c.total_spent).toFixed(2) %></td>
                    <td class="small text-secondary"><%= new Date(c.created_at).toLocaleDateString() %></td>
                    <td>
                      <% if (c.status === 'active') { %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                      <% } else if (c.status === 'blocked') { %>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Blocked</span>
                      <% } else { %>
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle"><%= c.status %></span>
                      <% } %>
                    </td>
                    <td class="text-end">
                      <a href="/admin/customers/<%= c.customer_id %>" class="btn btn-outline-info btn-sm rounded-pill me-1" title="View customer profile & history">
                        <i class="bi bi-eye"></i> View
                      </a>
                      <form action="/admin/customers/<%= c.customer_id %>/status" method="POST" class="d-inline">
                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                        <% if (c.status === 'active') { %>
                          <input type="hidden" name="status" value="blocked">
                          <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill" onclick="return confirm('Block this customer account?');">
                            <i class="bi bi-slash-circle me-1"></i> Block
                          </button>
                        <% } else { %>
                          <input type="hidden" name="status" value="active">
                          <button type="submit" class="btn btn-outline-success btn-sm rounded-pill">
                            <i class="bi bi-check-circle me-1"></i> Unblock
                          </button>
                        <% } %>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="9" class="text-center text-secondary py-5">No customer accounts registered yet.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

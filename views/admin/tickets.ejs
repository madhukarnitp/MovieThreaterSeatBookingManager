<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="row">
    <!-- Admin Sidebar Partial -->
    <%- include('../partials/admin-sidebar') %>

    <!-- Main Admin Content Area -->
    <div class="col-lg-9 col-xl-10 p-4 p-md-5">
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary-subtle gap-3">
        <div>
          <h2 class="fw-bold text-white mb-0">
            <i class="bi bi-upc text-warning me-2"></i>Issued Admission Tickets
          </h2>
          <p class="text-secondary small mb-0">Complete audit log of digital tickets, seat assignments, and usage records</p>
        </div>
        <a href="/admin/tickets/verify" class="btn btn-warning btn-sm rounded-pill px-3 fw-bold">
          <i class="bi bi-qr-code-scan me-1"></i> Open Gate Scanner
        </a>
      </div>

      <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle rounded-4 p-4 shadow-sm">
        <div class="table-responsive">
          <table class="table table-dark table-hover align-middle mb-0 small">
            <thead>
              <tr class="text-secondary">
                <th>Ticket Number</th>
                <th>Booking Ref</th>
                <th>Attendee</th>
                <th>Movie &amp; Theater</th>
                <th>Seat</th>
                <th>Price Paid</th>
                <th>Status</th>
                <th>Issued At</th>
              </tr>
            </thead>
            <tbody>
              <% if (tickets && tickets.length > 0) { %>
                <% tickets.forEach(function(t) { %>
                  <tr>
                    <td><span class="badge bg-warning text-dark font-monospace fw-bold"><%= t.ticket_number %></span></td>
                    <td><code><%= t.booking_ref %></code></td>
                    <td>
                      <div class="fw-semibold text-white"><%= t.customer_name %></div>
                      <div class="text-secondary" style="font-size: 0.7rem;"><%= t.customer_email %></div>
                    </td>
                    <td>
                      <div class="text-white"><%= t.movie_title %></div>
                      <div class="text-secondary" style="font-size: 0.7rem;"><%= t.theater_name %> &bull; <%= t.screen_name %></div>
                    </td>
                    <td>
                      <span class="badge bg-secondary font-monospace"><%= t.row_label %><%= t.seat_number %></span>
                    </td>
                    <td class="fw-semibold text-white">₹<%= Number(t.price_paid).toFixed(2) %></td>
                    <td>
                      <% if (t.ticket_status === 'valid') { %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">VALID</span>
                      <% } else if (t.ticket_status === 'used') { %>
                        <span class="badge bg-secondary text-light">USED</span>
                      <% } else { %>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><%= t.ticket_status.toUpperCase() %></span>
                      <% } %>
                    </td>
                    <td class="text-secondary"><%= new Date(t.issued_at).toLocaleString() %></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="8" class="text-center text-secondary py-4">No tickets have been generated yet.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

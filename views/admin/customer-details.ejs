<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="row">
    <!-- Admin Sidebar Partial -->
    <%- include('../partials/admin-sidebar') %>

    <!-- Main Admin Content Area -->
    <div class="col-lg-9 col-xl-10 p-4 p-md-5">
      <!-- Breadcrumb -->
      <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
          <li class="breadcrumb-item"><a href="/admin/dashboard" class="text-secondary text-decoration-none">Dashboard</a></li>
          <li class="breadcrumb-item"><a href="/admin/customers" class="text-secondary text-decoration-none">Customers</a></li>
          <li class="breadcrumb-item active text-warning" aria-current="page"><%= customer.full_name %></li>
        </ol>
      </nav>

      <!-- Customer Overview Card -->
      <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle rounded-4 p-4 shadow-sm mb-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
          <div class="d-flex align-items-center gap-3">
            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center shadow" style="width: 56px; height: 56px; font-size: 1.8rem;">
              <i class="bi bi-person-fill"></i>
            </div>
            <div>
              <h3 class="fw-bold text-white mb-0"><%= customer.full_name %></h3>
              <div class="text-secondary small">
                <i class="bi bi-envelope me-1"></i><%= customer.email %> &bull; <i class="bi bi-telephone ms-1 me-1"></i><%= customer.phone || 'No phone' %>
              </div>
              <div class="text-secondary small mt-1">
                Member since <%= new Date(customer.created_at).toLocaleDateString() %>
              </div>
            </div>
          </div>

          <!-- Account Status Toggle Form -->
          <div>
            <form action="/admin/customers/<%= customer.customer_id %>/status" method="POST" class="d-inline">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <% if (customer.status === 'active') { %>
                <input type="hidden" name="status" value="blocked">
                <button type="submit" class="btn btn-outline-danger rounded-pill px-4" onclick="return confirm('Block this customer account? Blocked accounts cannot book seats.');">
                  <i class="bi bi-lock-fill me-1"></i> Block Account
                </button>
              <% } else { %>
                <input type="hidden" name="status" value="active">
                <button type="submit" class="btn btn-success rounded-pill px-4">
                  <i class="bi bi-unlock-fill me-1"></i> Activate Account
                </button>
              <% } %>
            </form>
          </div>
        </div>
      </div>

      <!-- Customer Booking History -->
      <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle rounded-4 p-4 shadow-sm">
        <h5 class="fw-bold text-white mb-3">
          <i class="bi bi-clock-history text-warning me-2"></i>Booking History (<%= bookings.length %>)
        </h5>

        <div class="table-responsive">
          <table class="table table-dark table-hover align-middle mb-0 small">
            <thead>
              <tr class="text-secondary">
                <th>Reference</th>
                <th>Movie</th>
                <th>Theater &amp; Screen</th>
                <th>Showtime</th>
                <th>Tickets</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Booked At</th>
              </tr>
            </thead>
            <tbody>
              <% if (bookings && bookings.length > 0) { %>
                <% bookings.forEach(function(b) { %>
                  <tr>
                    <td><code><%= b.booking_ref %></code></td>
                    <td class="fw-semibold text-white"><%= b.movie_title %></td>
                    <td><%= b.theater_name %> &bull; <%= b.screen_name %></td>
                    <td><%= new Date(b.start_time).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
                    <td><span class="badge bg-secondary font-monospace"><%= b.ticket_count %></span></td>
                    <td class="fw-bold text-white">₹<%= Number(b.total_amount).toFixed(2) %></td>
                    <td>
                      <% if (b.status === 'confirmed') { %>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">Confirmed</span>
                      <% } else if (b.status === 'pending') { %>
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Pending</span>
                      <% } else { %>
                        <span class="badge bg-secondary text-light"><%= b.status %></span>
                      <% } %>
                    </td>
                    <td class="text-secondary"><%= new Date(b.booked_at).toLocaleDateString() %></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="8" class="text-center text-secondary py-4">No bookings made by this customer yet.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

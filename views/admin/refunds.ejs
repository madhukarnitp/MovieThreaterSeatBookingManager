<%- include('../partials/header') %>

<div class="container-fluid">
  <div class="row">
    <!-- Admin Sidebar Partial -->
    <%- include('../partials/admin-sidebar') %>

    <!-- Main Admin Content Area -->
    <div class="col-lg-9 col-xl-10 p-4 p-md-5">
      <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary-subtle gap-3">
        <div>
          <h2 class="fw-bold text-white mb-0">
            <i class="bi bi-arrow-counterclockwise text-danger me-2"></i>Refund Audit Records
          </h2>
          <p class="text-secondary small mb-0">Record of customer refund transactions, dispute resolutions, and cancellations</p>
        </div>
      </div>

      <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle rounded-4 p-4 shadow-sm">
        <div class="table-responsive">
          <table class="table table-dark table-hover align-middle mb-0 small">
            <thead>
              <tr class="text-secondary">
                <th>Refund Ref</th>
                <th>Payment Txn</th>
                <th>Booking Ref</th>
                <th>Customer</th>
                <th>Amount</th>
                <th>Reason</th>
                <th>Status</th>
                <th>Initiated At</th>
              </tr>
            </thead>
            <tbody>
              <% if (refunds && refunds.length > 0) { %>
                <% refunds.forEach(function(r) { %>
                  <tr>
                    <td><code class="text-warning"><%= r.refund_ref %></code></td>
                    <td><code class="text-light"><%= r.transaction_ref %></code></td>
                    <td><code><%= r.booking_ref %></code></td>
                    <td>
                      <div class="fw-semibold text-white"><%= r.customer_name %></div>
                      <div class="text-secondary" style="font-size: 0.7rem;"><%= r.customer_email %></div>
                    </td>
                    <td class="fw-bold text-danger">₹<%= Number(r.amount).toFixed(2) %></td>
                    <td><%= r.reason || 'N/A' %></td>
                    <td>
                      <span class="badge <%= r.refund_status === 'processed' ? 'bg-success' : 'bg-warning' %> text-uppercase">
                        <%= r.refund_status %>
                      </span>
                    </td>
                    <td class="text-secondary"><%= new Date(r.initiated_at).toLocaleString() %></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="8" class="text-center text-secondary py-4">No refund records found.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

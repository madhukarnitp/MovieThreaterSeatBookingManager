<%- include('../partials/header') %>

<div class="container py-4">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
      <li class="breadcrumb-item"><a href="/" class="text-secondary text-decoration-none">Home</a></li>
      <li class="breadcrumb-item"><a href="/customer/dashboard" class="text-secondary text-decoration-none">Dashboard</a></li>
      <li class="breadcrumb-item active text-warning" aria-current="page">My Tickets</li>
    </ol>
  </nav>

  <!-- Customer Sub-Navigation Tabs -->
  <ul class="nav nav-pills gap-2 mb-4 p-2 bg-dark rounded-pill border border-secondary border-opacity-25 justify-content-center justify-content-md-start">
    <li class="nav-item">
      <a class="nav-link text-light rounded-pill px-4" href="/customer/dashboard">
        <i class="bi bi-speedometer2 me-1"></i> Overview
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link text-light rounded-pill px-4" href="/customer/bookings?filter=upcoming">
        <i class="bi bi-calendar-event me-1"></i> Upcoming
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link text-light rounded-pill px-4" href="/customer/bookings">
        <i class="bi bi-ticket-perforated me-1"></i> My Bookings
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link active bg-warning text-dark fw-bold rounded-pill px-4" href="/customer/tickets">
        <i class="bi bi-qr-code-scan me-1"></i> My Tickets
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link text-light rounded-pill px-4" href="/customer/profile">
        <i class="bi bi-person-circle me-1"></i> Profile &amp; Security
      </a>
    </li>
  </ul>

  <!-- Tickets Cards Grid -->
  <% if (tickets && tickets.length > 0) { %>
    <div class="row g-4">
      <% tickets.forEach(function(t) { %>
        <div class="col-md-6 col-lg-4">
          <div class="ticket-card bg-black border border-warning border-opacity-50 rounded-4 overflow-hidden shadow-lg p-3 position-relative">
            
            <!-- Top Header -->
            <div class="d-flex justify-content-between align-items-center border-bottom border-secondary border-opacity-50 pb-2 mb-3">
              <span class="badge bg-warning text-dark fw-bold font-monospace">
                <%= t.ticket_number %>
              </span>
              <span class="badge <%= t.ticket_status === 'valid' ? 'bg-success' : (t.ticket_status === 'used' ? 'bg-secondary' : 'bg-danger') %> text-uppercase small">
                <%= t.ticket_status %>
              </span>
            </div>

            <!-- QR Code and Seat Highlight -->
            <div class="row g-2 align-items-center mb-3">
              <div class="col-auto">
                <div class="bg-white p-2 rounded-3 text-center shadow-sm" style="width: 105px; height: 105px;">
                  <img src="<%= t.qr_code_path %>" alt="QR Code" class="img-fluid w-100 h-100 object-fit-contain">
                </div>
              </div>
              <div class="col text-center">
                <div class="text-secondary small text-uppercase" style="font-size: 0.7rem;">Seat Code</div>
                <div class="display-6 fw-bold text-warning mb-0 font-monospace">
                  <%= t.row_label %><%= t.seat_number %>
                </div>
                <div class="badge bg-secondary-subtle text-light small"><%= t.seat_category %></div>
                <div class="text-secondary small mt-1">₹<%= Number(t.price_paid).toFixed(2) %></div>
              </div>
            </div>

            <!-- Bottom Meta -->
            <div class="border-top border-secondary border-opacity-50 pt-2 small text-secondary">
              <div class="text-truncate text-white fw-semibold mb-1"><%= t.movie_title %></div>
              <div class="text-truncate" style="font-size: 0.75rem;"><%= t.theater_name %> &bull; <%= t.screen_name %></div>
              <div class="text-warning" style="font-size: 0.72rem;">
                <%= new Date(t.start_time).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
              </div>
              <div class="mt-2 text-end">
                <a href="/tickets/<%= t.ticket_number %>" target="_blank" class="btn btn-outline-warning btn-sm rounded-pill px-3 py-0 fw-semibold" style="font-size: 0.75rem;">
                  <i class="bi bi-printer me-1"></i> Print Pass
                </a>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle rounded-4 p-5 text-center shadow-sm">
      <i class="bi bi-qr-code-scan display-3 text-secondary mb-3 d-block opacity-50"></i>
      <h4 class="text-white fw-bold mb-2">No Active Tickets</h4>
      <p class="text-secondary mb-4">Confirmed tickets will appear here with scannable QR passes.</p>
      <div>
        <a href="/movies" class="btn btn-warning rounded-pill px-4 fw-bold">
          <i class="bi bi-camera-reels me-1"></i> Book a Movie Now
        </a>
      </div>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>

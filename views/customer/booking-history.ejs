<%- include('../partials/header') %>

<div class="container py-4">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
      <li class="breadcrumb-item"><a href="/" class="text-secondary text-decoration-none">Home</a></li>
      <li class="breadcrumb-item"><a href="/customer/dashboard" class="text-secondary text-decoration-none">Dashboard</a></li>
      <li class="breadcrumb-item active text-warning" aria-current="page">Booking History</li>
    </ol>
  </nav>

  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h3 class="text-white fw-bold mb-1">
        <i class="bi bi-clock-history text-warning me-2"></i>My Bookings & Tickets
      </h3>
      <p class="text-secondary mb-0">View your confirmed tickets, past transactions, and booking statuses.</p>
    </div>
    <a href="/movies" class="btn btn-warning rounded-pill px-4 fw-semibold">
      <i class="bi bi-camera-reels me-1"></i> Book More Movies
    </a>
  </div>

  <% if (bookings && bookings.length > 0) { %>
    <div class="row g-4">
      <% bookings.forEach(function(b) { %>
        <div class="col-12">
          <div class="card bg-dark border-secondary border-opacity-25 rounded-4 p-4 shadow-lg hover-lift">
            <div class="row g-4 align-items-center">
              <!-- Poster -->
              <div class="col-sm-auto text-center">
                <img 
                  src="<%= b.poster_path %>" 
                  alt="<%= b.movie_title %>" 
                  class="rounded-3 shadow"
                  style="width: 85px; height: 120px; object-fit: cover;"
                  onerror="this.src='/images/posters/fallback.svg'"
                >
              </div>

              <!-- Details -->
              <div class="col">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                  <h5 class="text-white fw-bold mb-0"><%= b.movie_title %></h5>
                  <span class="badge bg-secondary-subtle text-light"><%= b.format %></span>
                  <span class="badge bg-secondary-subtle text-light"><%= b.language %></span>
                  
                  <% if (b.booking_status === 'confirmed') { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                      <i class="bi bi-check-circle me-1"></i>Confirmed
                    </span>
                  <% } else if (b.booking_status === 'pending') { %>
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                      <i class="bi bi-hourglass-split me-1"></i>Pending Payment
                    </span>
                  <% } else if (b.booking_status === 'expired') { %>
                    <span class="badge bg-secondary text-light">Expired</span>
                  <% } else { %>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                      <%= b.booking_status.toUpperCase() %>
                    </span>
                  <% } %>
                </div>

                <p class="text-secondary small mb-1">
                  <i class="bi bi-geo-alt text-warning me-1"></i><%= b.theater_name %> &bull; <%= b.screen_name %> (<%= b.city %>)
                </p>
                <p class="text-warning small mb-2 fw-semibold">
                  <i class="bi bi-clock me-1"></i><%= new Date(b.start_time).toLocaleString('en-US', { weekday: 'short', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                </p>

                <div class="d-flex flex-wrap gap-3 small text-secondary">
                  <span>Ref: <strong class="text-light font-monospace"><%= b.booking_ref %></strong></span>
                  <span>Amount: <strong class="text-white">₹<%= Number(b.total_amount).toFixed(2) %></strong></span>
                  <span>Booked: <%= new Date(b.booked_at).toLocaleDateString() %></span>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="col-md-auto text-md-end">
                <% if (b.booking_status === 'confirmed') { %>
                  <a href="/bookings/<%= b.booking_id %>/tickets" class="btn btn-warning rounded-pill px-4 fw-semibold mb-2 d-block d-md-inline-block">
                    <i class="bi bi-ticket-perforated me-1"></i> View Tickets (<%= b.ticket_count %>)
                  </a>
                <% } else if (b.booking_status === 'pending') { %>
                  <a href="/bookings/<%= b.booking_id %>/payment" class="btn btn-outline-warning rounded-pill px-4 fw-semibold mb-2 d-block d-md-inline-block">
                    <i class="bi bi-credit-card me-1"></i> Pay Now
                  </a>
                <% } else { %>
                  <a href="/showtimes/<%= b.showtime_id %>/seats" class="btn btn-outline-secondary rounded-pill px-4 small d-block d-md-inline-block">
                    <i class="bi bi-arrow-repeat me-1"></i> Book Again
                  </a>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="card bg-dark border-secondary border-opacity-25 rounded-4 p-5 text-center shadow-lg">
      <i class="bi bi-ticket-detailed display-3 text-secondary mb-3 d-block opacity-50"></i>
      <h4 class="text-white fw-bold mb-2">No Bookings Found</h4>
      <p class="text-secondary mb-4">You have not booked any movie tickets yet. Explore movies now!</p>
      <div>
        <a href="/movies" class="btn btn-warning rounded-pill px-4 fw-semibold">
          <i class="bi bi-camera-reels me-1"></i> Browse Now Showing
        </a>
      </div>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>

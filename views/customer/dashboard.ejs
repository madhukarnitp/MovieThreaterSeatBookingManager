<%- include('../partials/header') %>

<div class="container py-4">
  <!-- Top Welcome Hero -->
  <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle rounded-4 p-4 p-md-5 mb-4 shadow-sm position-relative overflow-hidden">
    <div class="row align-items-center">
      <div class="col-lg-8">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-warning bg-opacity-10 border border-warning border-opacity-25 text-warning mb-3 small fw-semibold">
          <i class="bi bi-shield-check"></i>
          <span>Verified Member Portal</span>
        </div>
        <h1 class="display-6 fw-bold text-white mb-2">Welcome back, <%= customer.full_name %>!</h1>
        <p class="text-secondary mb-0">
          <i class="bi bi-envelope text-warning me-1"></i><%= customer.email %> 
          <% if (customer.phone) { %> &bull; <i class="bi bi-telephone text-warning ms-2 me-1"></i><%= customer.phone %> <% } %>
        </p>
      </div>
      <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
        <a href="/movies" class="btn btn-warning rounded-pill px-4 fw-bold shadow-sm me-2">
          <i class="bi bi-camera-reels me-1"></i> Book Movies
        </a>
        <a href="/theaters" class="btn btn-outline-light rounded-pill px-3 me-2">
          <i class="bi bi-building me-1"></i> Theaters
        </a>
        <form action="/auth/logout" method="POST" class="d-inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-outline-danger rounded-pill px-3">
            <i class="bi bi-box-arrow-right me-1"></i> Logout
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Customer Sub-Navigation Tabs -->
  <ul class="nav nav-pills gap-2 mb-4 p-2 bg-dark rounded-pill border border-secondary border-opacity-25 justify-content-center justify-content-md-start">
    <li class="nav-item">
      <a class="nav-link active bg-warning text-dark fw-bold rounded-pill px-4" href="/customer/dashboard">
        <i class="bi bi-speedometer2 me-1"></i> Overview
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link text-light rounded-pill px-4" href="/customer/bookings">
        <i class="bi bi-ticket-perforated me-1"></i> My Bookings
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link text-light rounded-pill px-4" href="/movies">
        <i class="bi bi-film me-1"></i> All Movies
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link text-light rounded-pill px-4" href="/theaters">
        <i class="bi bi-building me-1"></i> Theaters &amp; Screens
      </a>
    </li>
  </ul>

  <!-- KPI Metric Cards -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
      <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle p-3 rounded-4 h-100">
        <span class="text-secondary small text-uppercase fw-semibold">Total Bookings</span>
        <div class="display-6 fw-bold text-white mt-1"><%= stats.totalBookings %></div>
        <div class="text-secondary small mt-1">Lifetime bookings placed</div>
      </div>
    </div>

    <div class="col-sm-6 col-lg-3">
      <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle p-3 rounded-4 h-100">
        <span class="text-secondary small text-uppercase fw-semibold">Upcoming Shows</span>
        <div class="display-6 fw-bold text-warning mt-1"><%= stats.upcomingBookings %></div>
        <div class="text-secondary small mt-1">Confirmed upcoming cinema tickets</div>
      </div>
    </div>

    <div class="col-sm-6 col-lg-3">
      <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle p-3 rounded-4 h-100">
        <span class="text-secondary small text-uppercase fw-semibold">Available Tickets</span>
        <div class="display-6 fw-bold text-success mt-1"><%= stats.validTickets %></div>
        <div class="text-secondary small mt-1">Active scannable QR passes</div>
      </div>
    </div>

    <div class="col-sm-6 col-lg-3">
      <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle p-3 rounded-4 h-100">
        <span class="text-secondary small text-uppercase fw-semibold">Total Spent</span>
        <div class="display-6 fw-bold text-white mt-1">₹<%= Number(stats.totalSpent || 0).toFixed(2) %></div>
        <div class="text-secondary small mt-1">On confirmed admissions</div>
      </div>
    </div>
  </div>

  <!-- Recent Bookings Table -->
  <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle rounded-4 p-4 shadow-sm mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h5 class="fw-bold text-white mb-0">
        <i class="bi bi-clock-history text-warning me-2"></i>Recent Bookings
      </h5>
      <a href="/customer/bookings" class="text-warning small text-decoration-none fw-semibold">View All Bookings &rarr;</a>
    </div>

    <div class="table-responsive">
      <table class="table table-dark table-hover align-middle mb-0 small">
        <thead>
          <tr class="text-secondary small">
            <th>Reference</th>
            <th>Movie &amp; Theater</th>
            <th>Showtime</th>
            <th>Seats</th>
            <th>Total Amount</th>
            <th>Payment</th>
            <th>Booking Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (recentBookings && recentBookings.length > 0) { %>
            <% recentBookings.forEach(function(b) { %>
              <tr>
                <td><code><%= b.booking_ref %></code></td>
                <td>
                  <div class="fw-semibold text-white"><%= b.movie_title %></div>
                  <div class="text-secondary" style="font-size: 0.72rem;"><%= b.theater_name %> &bull; <%= b.screen_name %></div>
                </td>
                <td>
                  <div><%= b.formatted_date || (b.show_date ? formatDate(b.show_date) : 'N/A') %></div>
                  <span class="text-warning fw-semibold"><%= b.formatted_time || (b.start_time ? formatTime(b.start_time) : 'N/A') %></span>
                </td>
                <td>
                  <span class="badge bg-secondary font-monospace"><%= b.seat_codes || 'N/A' %></span>
                </td>
                <td class="fw-bold text-white">₹<%= Number(b.total_amount || 0).toFixed(2) %></td>
                <td>
                  <% if (b.payment_status === 'SUCCESS') { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                      <i class="bi bi-check-circle me-1"></i>PAID
                    </span>
                  <% } else if (b.payment_status === 'FAILED') { %>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                      <i class="bi bi-x-circle me-1"></i>FAILED
                    </span>
                  <% } else { %>
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                      <i class="bi bi-clock me-1"></i>PENDING
                    </span>
                  <% } %>
                </td>
                <td>
                  <% if (b.booking_status === 'CONFIRMED') { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">Confirmed</span>
                  <% } else if (b.booking_status === 'CANCELLED') { %>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Cancelled</span>
                  <% } else { %>
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Pending</span>
                  <% } %>
                </td>
                <td class="text-end">
                  <div class="d-inline-flex align-items-center gap-1">
                    <% if (b.booking_status === 'CONFIRMED') { %>
                      <a href="/bookings/<%= b.booking_id %>/confirmation" class="btn btn-warning btn-sm rounded-pill px-3 fw-semibold" title="View Ticket Pass">
                        <i class="bi bi-ticket-perforated me-1"></i> Ticket
                      </a>
                    <% } else if (b.booking_status === 'PENDING') { %>
                      <a href="/bookings/<%= b.booking_id %>/payment" class="btn btn-outline-warning btn-sm rounded-pill px-3 fw-semibold">
                        <i class="bi bi-credit-card me-1"></i> Pay
                      </a>
                    <% } %>

                    <% if (b.is_cancellable) { %>
                      <form action="/bookings/<%= b.booking_id %>/cancel" method="POST" class="d-inline ms-1" onsubmit="return confirm('Cancel this booking and release seats?');">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2.5" title="Cancel Booking">
                          <i class="bi bi-x-circle"></i> Cancel
                        </button>
                      </form>
                    <% } else { %>
                      <span class="text-secondary small ms-1">&mdash;</span>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="8" class="text-center text-secondary py-4">No recent bookings found.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

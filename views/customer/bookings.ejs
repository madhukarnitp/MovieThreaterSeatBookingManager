<%- include('../partials/header') %>

<div class="container py-4">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
      <li class="breadcrumb-item"><a href="/" class="text-secondary text-decoration-none">Home</a></li>
      <li class="breadcrumb-item"><a href="/customer/dashboard" class="text-secondary text-decoration-none">Dashboard</a></li>
      <li class="breadcrumb-item active text-warning" aria-current="page">My Bookings</li>
    </ol>
  </nav>

  <!-- Customer Sub-Navigation Tabs -->
  <ul class="nav nav-pills gap-2 mb-4 p-2 bg-dark rounded-pill border border-secondary border-opacity-25 justify-content-center justify-content-md-start">
    <li class="nav-item">
      <a class="nav-link text-light rounded-pill px-4" href="/customer/dashboard">
        <i class="bi bi-speedometer2 me-1"></i> Overview
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link <%= activeFilter === 'upcoming' ? 'active bg-warning text-dark fw-bold' : 'text-light' %> rounded-pill px-4" href="/customer/bookings?filter=upcoming">
        <i class="bi bi-calendar-event me-1"></i> Upcoming
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link <%= activeFilter === 'all' ? 'active bg-warning text-dark fw-bold' : 'text-light' %> rounded-pill px-4" href="/customer/bookings">
        <i class="bi bi-ticket-perforated me-1"></i> All Bookings
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link <%= activeFilter === 'past' ? 'active bg-warning text-dark fw-bold' : 'text-light' %> rounded-pill px-4" href="/customer/bookings?filter=past">
        <i class="bi bi-clock-history me-1"></i> Past
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link <%= activeFilter === 'cancelled' ? 'active bg-warning text-dark fw-bold' : 'text-light' %> rounded-pill px-4" href="/customer/bookings?filter=cancelled">
        <i class="bi bi-x-circle me-1"></i> Cancelled
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link text-light rounded-pill px-4" href="/customer/tickets">
        <i class="bi bi-qr-code-scan me-1"></i> My Tickets
      </a>
    </li>
  </ul>

  <!-- Bookings List -->
  <% if (bookings && bookings.length > 0) { %>
    <div class="row g-4">
      <% bookings.forEach(function(b) { %>
        <div class="col-12">
          <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle rounded-4 p-4 shadow-sm hover-lift">
            <div class="row g-4 align-items-center">
              <!-- Movie Poster -->
              <div class="col-sm-auto text-center">
                <img 
                  src="<%= b.poster_path %>" 
                  alt="<%= b.movie_title %>" 
                  class="rounded-3 shadow"
                  style="width: 85px; height: 125px; object-fit: cover;"
                  onerror="this.src='/images/posters/fallback.svg'"
                >
              </div>

              <!-- Booking & Movie Info -->
              <div class="col">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                  <h5 class="text-white fw-bold mb-0"><%= b.movie_title %></h5>
                  <span class="badge text-bg-warning fw-bold"><%= b.certification %></span>
                  <span class="badge bg-secondary-subtle text-light"><%= b.format %></span>
                  <span class="badge bg-secondary-subtle text-light"><%= b.language %></span>
                  
                  <% if (b.booking_status === 'confirmed') { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                      <i class="bi bi-check-circle me-1"></i>Confirmed
                    </span>
                  <% } else if (b.booking_status === 'pending') { %>
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                      <i class="bi bi-hourglass-split me-1"></i>Pending Hold
                    </span>
                  <% } else if (b.booking_status === 'cancelled') { %>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Cancelled</span>
                  <% } else if (b.booking_status === 'refunded') { %>
                    <span class="badge bg-info-subtle text-info border border-info-subtle">Refunded</span>
                  <% } else { %>
                    <span class="badge bg-secondary text-light"><%= b.booking_status.toUpperCase() %></span>
                  <% } %>
                </div>

                <p class="text-secondary small mb-1">
                  <i class="bi bi-geo-alt text-warning me-1"></i><strong><%= b.theater_name %></strong> &bull; <%= b.screen_name %> (<%= b.city %>)
                </p>
                <p class="text-warning small mb-2 fw-semibold">
                  <i class="bi bi-clock me-1"></i><%= new Date(b.start_time).toLocaleString('en-US', { weekday: 'short', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                </p>

                <div class="d-flex flex-wrap gap-3 small text-secondary">
                  <span>Ref: <strong class="text-light font-monospace"><%= b.booking_ref %></strong></span>
                  <span>Seats: <strong class="text-warning font-monospace"><%= b.seat_codes %></strong></span>
                  <span>Total Amount: <strong class="text-white">₹<%= Number(b.total_amount).toFixed(2) %></strong></span>
                  <% if (b.refund_status) { %>
                    <span>Refund: <strong class="text-info font-monospace">₹<%= Number(b.refund_amount).toFixed(2) %> (<%= b.refund_status %>)</strong></span>
                  <% } %>
                </div>
              </div>

              <!-- Action Controls (View, Print, Cancel) -->
              <div class="col-md-auto text-md-end">
                <% if (b.booking_status === 'confirmed') { %>
                  <a href="/bookings/<%= b.booking_id %>/tickets" class="btn btn-warning btn-sm rounded-pill px-4 fw-bold me-2 mb-2 mb-md-0 shadow-sm">
                    <i class="bi bi-qr-code me-1"></i> View Tickets
                  </a>

                  <% if (b.is_cancellable) { %>
                    <form action="/customer/bookings/<%= b.booking_id %>/cancel" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this booking? Eligible funds will be processed for refund.');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                        <i class="bi bi-x-circle me-1"></i> Cancel
                      </button>
                    </form>
                  <% } %>
                <% } else if (b.booking_status === 'pending') { %>
                  <a href="/bookings/<%= b.booking_id %>/payment" class="btn btn-outline-warning btn-sm rounded-pill px-4 fw-bold">
                    <i class="bi bi-credit-card me-1"></i> Pay Now
                  </a>
                <% } else { %>
                  <a href="/showtimes/<%= b.showtime_id %>/seats" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-repeat me-1"></i> Book Again
                  </a>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle rounded-4 p-5 text-center shadow-sm">
      <i class="bi bi-ticket-perforated display-3 text-secondary mb-3 d-block opacity-50"></i>
      <h4 class="text-white fw-bold mb-2">No Bookings Found</h4>
      <p class="text-secondary mb-4">No reservations match the selected filter.</p>
      <div>
        <a href="/movies" class="btn btn-warning rounded-pill px-4 fw-bold">
          <i class="bi bi-camera-reels me-1"></i> Explore Movies
        </a>
      </div>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>

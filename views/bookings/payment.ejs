<%- include('../partials/header') %>

<div class="container py-4">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
      <li class="breadcrumb-item"><a href="/" class="text-secondary text-decoration-none">Home</a></li>
      <li class="breadcrumb-item"><a href="/movies" class="text-secondary text-decoration-none">Movies</a></li>
      <li class="breadcrumb-item"><a href="/movies/<%= booking.movie_id %>" class="text-secondary text-decoration-none"><%= booking.movie_title %></a></li>
      <li class="breadcrumb-item active text-warning" aria-current="page">Simulated Payment</li>
    </ol>
  </nav>

  <div class="row g-4 justify-content-center">
    <div class="col-lg-8">
      
      <!-- Academic / Demo Notice Banner -->
      <div class="alert alert-info border-info border-opacity-50 bg-black text-light p-3 rounded-4 shadow-sm mb-4">
        <div class="d-flex align-items-center gap-3">
          <div class="fs-2 text-info"><i class="bi bi-mortarboard-fill"></i></div>
          <div>
            <div class="fw-bold text-white">College DBMS Demonstration Mode</div>
            <div class="small text-secondary">
              This payment gateway is completely simulated. No real credit/debit card numbers, CVVs, or UPI PINs will be collected or charged.
            </div>
          </div>
        </div>
      </div>

      <!-- Hold Countdown Timer -->
      <div class="card bg-warning bg-opacity-10 border border-warning border-opacity-50 rounded-4 p-3 mb-4 shadow-sm">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
          <div class="d-flex align-items-center gap-3">
            <div class="hold-timer-icon bg-warning text-dark rounded-circle d-flex align-items-center justify-content-center shadow" style="width: 44px; height: 44px; font-size: 1.3rem;">
              <i class="bi bi-stopwatch-fill"></i>
            </div>
            <div>
              <h6 class="text-warning fw-bold mb-0">Seat Reservation Hold Active</h6>
              <small class="text-white opacity-75">Complete payment before timer expires to finalize ticket issuance.</small>
            </div>
          </div>
          <div class="text-end">
            <span class="fs-4 fw-mono fw-bold text-warning" id="countdown-timer" data-seconds="<%= booking.remainingSeconds %>">--:--</span>
          </div>
        </div>
      </div>

      <!-- Order Summary Card -->
      <div class="card bg-dark border-secondary border-opacity-25 rounded-4 p-4 shadow-lg mb-4">
        <div class="d-flex align-items-center justify-content-between border-bottom border-secondary border-opacity-25 pb-3 mb-4">
          <h5 class="text-white fw-bold mb-0">
            <i class="bi bi-receipt text-warning me-2"></i>Booking Details
          </h5>
          <span class="badge bg-secondary-subtle text-light font-monospace fs-6">Ref: <%= booking.booking_ref %></span>
        </div>

        <div class="row g-4 mb-4">
          <div class="col-sm-auto">
            <img 
              src="<%= booking.poster_path %>" 
              alt="<%= booking.movie_title %>" 
              class="rounded-3 shadow"
              style="width: 90px; height: 130px; object-fit: cover;"
              onerror="this.src='/images/posters/fallback.svg'"
            >
          </div>
          <div class="col">
            <h4 class="text-white fw-bold mb-1"><%= booking.movie_title %></h4>
            <div class="d-flex flex-wrap gap-2 mb-2">
              <span class="badge text-bg-warning fw-bold"><%= booking.certification %></span>
              <span class="badge bg-secondary-subtle text-light"><%= booking.format %></span>
              <span class="badge bg-secondary-subtle text-light"><%= booking.language %></span>
            </div>
            <p class="text-secondary small mb-1">
              <i class="bi bi-geo-alt text-warning me-1"></i><strong><%= booking.theater_name %></strong> &bull; <%= booking.screen_name %>
            </p>
            <p class="text-warning small mb-1 fw-semibold">
              <i class="bi bi-clock me-1"></i><%= new Date(booking.start_time).toLocaleString('en-US', { weekday: 'short', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
            </p>
            <p class="text-secondary small mb-0">
              <i class="bi bi-person me-1"></i>Customer: <%= booking.customer_name %>
            </p>
          </div>
        </div>

        <!-- Seats Itemization -->
        <h6 class="text-white fw-semibold mb-2">Selected Seats (<%= booking.seats.length %>)</h6>
        <div class="table-responsive mb-3">
          <table class="table table-dark table-hover table-bordered border-secondary border-opacity-25 rounded-3 align-middle mb-0">
            <thead class="table-secondary text-uppercase small text-secondary">
              <tr>
                <th>Seat</th>
                <th>Category</th>
                <th class="text-end">Amount</th>
              </tr>
            </thead>
            <tbody>
              <% booking.seats.forEach(function(s) { %>
                <tr>
                  <td>
                    <span class="badge bg-warning text-dark fw-bold px-2 py-1">
                      <%= s.row_label %><%= s.seat_number %>
                    </span>
                  </td>
                  <td><%= s.category_name %></td>
                  <td class="text-end text-light fw-semibold">₹<%= Number(s.price_paid).toFixed(2) %></td>
                </tr>
              <% }); %>
            </tbody>
            <tfoot class="border-top border-warning">
              <tr>
                <td colspan="2" class="fw-bold fs-5 text-white">Total Ticket Amount</td>
                <td class="text-end fw-bold fs-4 text-warning">₹<%= Number(booking.total_amount).toFixed(2) %></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>

      <!-- Payment Simulation Form Card -->
      <div class="card bg-dark border-secondary border-opacity-25 rounded-4 p-4 shadow-lg mb-4">
        <h5 class="text-white fw-bold mb-3 border-bottom border-secondary border-opacity-25 pb-2">
          <i class="bi bi-credit-card-2-front text-warning me-2"></i>Select Payment Method
        </h5>

        <form action="/bookings/<%= booking.booking_id %>/pay" method="POST" id="payment-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <!-- Payment Method Radios -->
          <div class="row g-3 mb-4">
            <div class="col-md-4">
              <label class="payment-method-card d-block p-3 rounded-3 border border-secondary border-opacity-50 cursor-pointer text-center bg-black">
                <input type="radio" name="payment_method" value="upi" class="form-check-input d-none" checked>
                <i class="bi bi-qr-code-scan display-6 text-warning d-block mb-2"></i>
                <div class="fw-bold text-white small">UPI (Simulated)</div>
                <div class="text-secondary" style="font-size: 0.75rem;">GPay / PhonePe / Paytm</div>
              </label>
            </div>
            <div class="col-md-4">
              <label class="payment-method-card d-block p-3 rounded-3 border border-secondary border-opacity-50 cursor-pointer text-center bg-black">
                <input type="radio" name="payment_method" value="card" class="form-check-input d-none">
                <i class="bi bi-credit-card display-6 text-warning d-block mb-2"></i>
                <div class="fw-bold text-white small">Card (Simulated)</div>
                <div class="text-secondary" style="font-size: 0.75rem;">Visa / Mastercard / RuPay</div>
              </label>
            </div>
            <div class="col-md-4">
              <label class="payment-method-card d-block p-3 rounded-3 border border-secondary border-opacity-50 cursor-pointer text-center bg-black">
                <input type="radio" name="payment_method" value="netbanking" class="form-check-input d-none">
                <i class="bi bi-bank display-6 text-warning d-block mb-2"></i>
                <div class="fw-bold text-white small">Net Banking (Simulated)</div>
                <div class="text-secondary" style="font-size: 0.75rem;">All Major Indian Banks</div>
              </label>
            </div>
          </div>

          <!-- Simulation Action Buttons -->
          <div class="p-3 bg-black rounded-3 border border-secondary border-opacity-50 mb-4">
            <h6 class="text-white fw-bold mb-2">Simulation Sandbox Options:</h6>
            <p class="text-secondary small mb-3">
              Choose an outcome below to test transaction handling and database ACID semantics.
            </p>
            <div class="row g-3">
              <div class="col-md-6">
                <button type="submit" name="simulation_action" value="success" class="btn btn-success w-100 py-3 rounded-pill fw-bold fs-6 shadow">
                  <i class="bi bi-check-circle-fill me-2"></i>Simulate Successful Payment
                </button>
                <div class="text-center text-secondary small mt-1" style="font-size: 0.75rem;">
                  Confirms booking &bull; Generates QR tickets
                </div>
              </div>
              <div class="col-md-6">
                <button type="submit" name="simulation_action" value="fail" class="btn btn-outline-danger w-100 py-3 rounded-pill fw-bold fs-6">
                  <i class="bi bi-x-circle-fill me-2"></i>Simulate Failed Payment
                </button>
                <div class="text-center text-secondary small mt-1" style="font-size: 0.75rem;">
                  Records failure &bull; Allows retry while held
                </div>
              </div>
            </div>
          </div>
        </form>

        <div class="d-flex flex-wrap justify-content-between align-items-center pt-2">
          <form action="/bookings/<%= booking.booking_id %>/cancel" method="POST" onsubmit="return confirm('Are you sure you want to release these held seats?');">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-link text-danger text-decoration-none small p-0">
              <i class="bi bi-trash me-1"></i> Cancel Hold & Release Seats
            </button>
          </form>

          <a href="/showtimes/<%= booking.showtime_id %>/seats" class="text-secondary small text-decoration-none">
            <i class="bi bi-arrow-left me-1"></i> Back to Seat Selection
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .payment-method-card {
    transition: all 0.2s ease;
  }
  .payment-method-card:hover {
    border-color: #f59e0b !important;
    background-color: rgba(245, 158, 11, 0.05) !important;
  }
  .payment-method-card input[type="radio"]:checked + i,
  .payment-method-card:has(input[type="radio"]:checked) {
    border-color: #f59e0b !important;
    background-color: rgba(245, 158, 11, 0.1) !important;
    box-shadow: 0 0 10px rgba(245, 158, 11, 0.2);
  }
</style>

<script>
  // Countdown Timer Script for Hold Window
  document.addEventListener('DOMContentLoaded', function() {
    const timerEl = document.getElementById('countdown-timer');
    if (!timerEl) return;

    let seconds = parseInt(timerEl.getAttribute('data-seconds'), 10) || 0;

    function updateDisplay() {
      if (seconds <= 0) {
        timerEl.textContent = 'EXPIRED';
        timerEl.classList.remove('text-warning');
        timerEl.classList.add('text-danger');
        alert('Your 10-minute hold has expired. The seats have been released.');
        window.location.href = '/showtimes/<%= booking.showtime_id %>/seats';
        return;
      }

      const mins = Math.floor(seconds / 60);
      const secs = seconds % 60;
      timerEl.textContent = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
      seconds--;
    }

    updateDisplay();
    const interval = setInterval(updateDisplay, 1000);
  });
</script>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>

  <div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
      <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a href="/" class="text-secondary text-decoration-none">Home</a></li>
        <li class="breadcrumb-item"><a href="/movies" class="text-secondary text-decoration-none">Movies</a></li>
        <li class="breadcrumb-item"><a href="/movies/<%= booking.movie_id %>"
            class="text-secondary text-decoration-none">
            <%= booking.movie_title %>
          </a></li>
        <li class="breadcrumb-item active text-warning" aria-current="page">Confirm Payment</li>
      </ol>
    </nav>

    <div class="row g-4 justify-content-center">
      <div class="col-lg-8">

        <!-- Simulated Checkout Notice Banner -->
        <div class="alert alert-info border-info border-opacity-50 bg-black text-light p-3 rounded-4 shadow-sm mb-4">
          <div class="d-flex align-items-center gap-3">
            <div class="fs-2 text-info"><i class="bi bi-shield-check"></i></div>
            <div>
              <div class="fw-bold text-white">Simulated Checkout Mode</div>
              <div class="small text-secondary">
                This payment step is fully simulated. No real credit/debit cards or UPI credentials are required. Simply
                click the button below to complete the simulated transaction and confirm your booking.
              </div>
            </div>
          </div>
        </div>

        <!-- Order Summary Card -->
        <div class="card bg-dark border-secondary border-opacity-25 rounded-4 p-4 shadow-lg mb-4">
          <div
            class="d-flex align-items-center justify-content-between border-bottom border-secondary border-opacity-25 pb-3 mb-4">
            <h5 class="text-white fw-bold mb-0">
              <i class="bi bi-receipt text-warning me-2"></i>Booking Details
            </h5>
            <span class="badge bg-secondary-subtle text-light font-monospace fs-6">Ref: <%= booking.booking_ref %>
                </span>
          </div>

          <div class="row g-4 mb-4">
            <div class="col-sm-auto">
              <img src="<%= booking.poster_path %>" alt="<%= booking.movie_title %>" class="rounded-3 shadow"
                style="width: 90px; height: 130px; object-fit: cover;"
                onerror="this.src='/images/posters/fallback.svg'">
            </div>
            <div class="col">
              <h4 class="text-white fw-bold mb-1">
                <%= booking.movie_title %>
              </h4>
              <div class="d-flex flex-wrap gap-2 mb-2">
                <span class="badge text-bg-warning fw-bold">
                  <%= booking.certification || 'UA' %>
                </span>
                <span class="badge bg-secondary-subtle text-light">
                  <%= booking.format || '2D' %>
                </span>
                <span class="badge bg-secondary-subtle text-light">
                  <%= booking.language %>
                </span>
              </div>
              <p class="text-secondary small mb-1">
                <i class="bi bi-geo-alt text-warning me-1"></i><strong>
                  <%= booking.theater_name %>
                </strong> &bull; <%= booking.screen_name %>
              </p>
              <p class="text-warning small mb-1 fw-semibold">
                <i class="bi bi-clock me-1"></i>
                <%= booking.formatted_datetime %>
              </p>
              <p class="text-secondary small mb-0">
                <i class="bi bi-person me-1"></i>Customer: <%= booking.customer_name %>
              </p>
            </div>
          </div>

          <!-- Seats Itemization -->
          <h6 class="text-white fw-semibold mb-2">Selected Seats (<%= booking.seats.length %>)</h6>
          <div class="table-responsive mb-3">
            <table
              class="table table-dark table-hover table-bordered border-secondary border-opacity-25 rounded-3 align-middle mb-0">
              <thead class="table-secondary text-uppercase small text-secondary">
                <tr>
                  <th>Seat</th>
                  <th>Category</th>
                  <th class="text-end">Amount</th>
                </tr>
              </thead>
              <tbody>
                <% booking.seats.forEach(function(s) { %>
                  <tr>
                    <td>
                      <span class="badge bg-warning text-dark fw-bold px-2 py-1">
                        <%= s.row_label %>
                          <%= s.seat_number %>
                      </span>
                    </td>
                    <td>
                      <%= s.seat_type %>
                    </td>
                    <td class="text-end text-light fw-semibold">₹<%= Number(s.price).toFixed(2) %>
                    </td>
                  </tr>
                  <% }); %>
              </tbody>
              <tfoot class="border-top border-warning">
                <tr>
                  <td colspan="2" class="fw-bold fs-5 text-white">Total Amount</td>
                  <td class="text-end fw-bold fs-4 text-warning">₹<%= Number(booking.total_amount).toFixed(2) %>
                  </td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>

        <!-- Single Action Simulated Payment Card -->
        <div class="card bg-dark border-secondary border-opacity-25 rounded-4 p-4 shadow-lg mb-4 text-center">
          <form action="/bookings/<%= booking.booking_id %>/pay" method="POST" id="payment-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="booking_id" value="<%= booking.booking_id %>">

            <div class="mb-4">
              <div
                class="w-16 h-16 rounded-circle bg-warning bg-opacity-10 text-warning mx-auto d-flex align-items-center justify-content-center mb-3"
                style="width: 60px; height: 60px; font-size: 1.8rem;">
                <i class="bi bi-credit-card-2-front"></i>
              </div>
              <h5 class="text-white fw-bold mb-1">Simulated One-Click Checkout</h5>
              <p class="text-secondary small mb-0">
                Click below to simulate instant payment verification. The system will record the transaction in the
                database and issue your tickets.
              </p>
            </div>

            <!-- Single Simple Payment Button -->
            <button type="submit" class="btn btn-warning w-100 py-3 rounded-pill fw-bold fs-5 shadow-sm mb-3">
              <i class="bi bi-shield-check me-2"></i>Pay ₹<%= Number(booking.total_amount).toFixed(2) %> &amp; Confirm
                Booking
            </button>
          </form>

          <div class="d-flex justify-content-between align-items-center pt-2">
            <form action="/bookings/<%= booking.booking_id %>/cancel" method="POST"
              onsubmit="return confirm('Cancel this pending reservation?');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-link text-danger text-decoration-none small p-0">
                <i class="bi bi-trash me-1"></i> Cancel Reservation
              </button>
            </form>

            <a href="/showtimes/<%= booking.showtime_id %>/seats" class="text-secondary small text-decoration-none">
              <i class="bi bi-arrow-left me-1"></i> Back to Seat Selection
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/footer') %>
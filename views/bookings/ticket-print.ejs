<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ticket - <%= (typeof ticket !== 'undefined' && ticket && ticket.ticket_number) ? ticket.ticket_number : 'Admission Pass' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-ticket: #ffffff;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --border-color: #e2e8f0;
      --primary-accent: #0f172a;
      --highlight: #d97706;
    }

    * {
      box-sizing: border-box;
    }

    body {
      background-color: #0b0f19;
      color: #e2e8f0;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      margin: 0;
      padding: 0;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    .ticket-wrapper {
      max-width: 476px; /* Scaled down to 70% */
      margin: 24px auto 48px auto;
      padding: 0 12px;
      position: relative;
      z-index: 1;
    }

    .ticket-container {
      background: var(--bg-ticket);
      border-radius: 12px;
      box-shadow: 0 12px 24px -8px rgba(0, 0, 0, 0.4);
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.1);
      position: relative;
      margin-bottom: 16px;
      page-break-inside: avoid;
    }

    .ticket-container + .ticket-container {
      margin-top: 20px;
    }

    /* Notch styling for authentic cinema ticket appearance */
    .ticket-container::before,
    .ticket-container::after {
      content: '';
      position: absolute;
      top: 86px; /* 70% scale notch */
      width: 16px;
      height: 16px;
      background-color: #0b0f19;
      border-radius: 50%;
      z-index: 2;
    }

    .ticket-container::before {
      left: -8px;
    }

    .ticket-container::after {
      right: -8px;
    }

    .ticket-header {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%) !important;
      color: #ffffff !important;
      padding: 10px 14px;
      border-bottom: 2px dashed #334155;
      position: relative;
      z-index: 1;
    }

    .ticket-body {
      padding: 12px 14px;
      background: #ffffff;
    }

    .ticket-seat-badge {
      font-size: 1.45rem;
      font-weight: 800;
      color: #d97706;
      font-family: 'JetBrains Mono', monospace;
      line-height: 1.1;
    }

    .qr-frame {
      background: #ffffff;
      padding: 5px;
      border-radius: 6px;
      border: 1px solid #e2e8f0;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
      display: inline-block;
    }

    .qr-frame img {
      width: 78px;
      height: 78px;
      object-fit: contain;
      display: block;
    }

    /* Print Specific Media Styles */
    @media print {
      body {
        background-color: #ffffff !important;
        color: #000000 !important;
      }
      .no-print {
        display: none !important;
      }
      .ticket-wrapper {
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
      }
      .ticket-container {
        box-shadow: none !important;
        border: 2px dashed #475569 !important;
        border-radius: 12px !important;
        margin: 0 auto 20px auto !important;
        page-break-inside: avoid;
      }
      .ticket-container:not(:last-child) {
        page-break-after: always;
        break-after: page;
      }
      .ticket-container::before,
      .ticket-container::after {
        display: none !important;
      }
      .ticket-header {
        background: #0f172a !important;
        color: #ffffff !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
      .badge {
        border: 1px solid #000000 !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
    }
  </style>
</head>

<body class="bg-dark text-light">

  <div class="ticket-wrapper">
    <!-- Top Action Controls -->
    <div class="text-center mb-3 no-print d-flex justify-content-center gap-2">
      <button onclick="window.print()" class="btn btn-warning rounded-pill px-4 fw-bold shadow-sm">
        <i class="bi bi-printer-fill me-1.5"></i> Print Ticket
      </button>
      <a href="/customer/dashboard" class="btn btn-outline-light rounded-pill px-4 fw-medium">
        <i class="bi bi-arrow-left me-1"></i> My Bookings
      </a>
      <a href="/movies" class="btn btn-outline-secondary rounded-pill px-3 fw-medium">
        <i class="bi bi-collection me-1"></i> Browse Movies
      </a>
    </div>

    <!-- Printable Cinema Boarding Pass Ticket(s) -->
    <% 
      const ticketList = (typeof tickets !== 'undefined' && Array.isArray(tickets) && tickets.length > 0)
        ? tickets
        : ((typeof ticket !== 'undefined' && ticket) ? [ticket] : []);
      const totalCount = ticketList.length;
    %>
    <% for (let idx = 0; idx < totalCount; idx++) { 
         const t = ticketList[idx];
    %>
      <div class="ticket-container">
        <div class="ticket-header d-flex justify-content-between align-items-center">
          <div>
            <div class="d-flex align-items-center gap-1.5">
              <i class="bi bi-ticket-perforated-fill text-warning fs-6"></i>
              <span class="fw-bold tracking-wider text-uppercase" style="letter-spacing: 0.08em; font-size: 0.82rem;">Cinema Admission Pass</span>
            </div>
            <small class="text-secondary d-block mt-0.5" style="font-size: 0.68rem;">Official Digital Entry Voucher &bull; Ticket <%= idx + 1 %> of <%= totalCount %></small>
          </div>
          <div class="text-end">
            <span class="badge bg-warning text-dark font-monospace fw-bold px-2 py-1" style="font-size: 0.72rem;">
              <%= t.ticket_number || ('TKT-' + t.booking_ref + '-' + (t.seat_code || idx + 1)) %>
            </span>
          </div>
        </div>

        <div class="ticket-body">
          <div class="row align-items-center mb-3">
            <div class="col-7 col-sm-8">
              <h2 class="fw-bold mb-1 text-dark" style="font-size: 1.15rem; line-height: 1.25;"><%= t.movie_title || booking.movie_title %></h2>
              <p class="text-muted mb-2" style="font-size: 0.78rem;">
                <strong class="text-dark"><%= t.theater_name || booking.theater_name %></strong> &bull; <%= t.screen_name || booking.screen_name %>
              </p>
              <div class="d-flex flex-wrap gap-1 mb-2">
                <span class="badge bg-dark" style="font-size: 0.68rem; padding: 0.25rem 0.5rem;"><%= t.certification || 'U/A' %></span>
                <span class="badge bg-secondary" style="font-size: 0.68rem; padding: 0.25rem 0.5rem;"><%= t.format || '2D' %></span>
                <span class="badge bg-secondary" style="font-size: 0.68rem; padding: 0.25rem 0.5rem;"><%= t.language || 'Hindi' %></span>
                <span class="badge <%= (t.ticket_status || 'valid') === 'valid' ? 'bg-success' : 'bg-secondary' %>" style="font-size: 0.68rem; padding: 0.25rem 0.5rem;">
                  <%= (t.ticket_status || 'valid').toUpperCase() %>
                </span>
              </div>
              <div class="text-muted fw-semibold" style="font-size: 0.75rem;">
                <i class="bi bi-calendar-check text-warning me-1"></i>
                <%= t.formatted_datetime || booking.formatted_datetime || (t.show_date + ' ' + t.start_time) %>
              </div>
            </div>

            <div class="col-5 col-sm-4 text-center">
              <div class="qr-frame">
                <img 
                  src="<%= t.qr_code_path || ('https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=' + encodeURIComponent(t.ticket_number || t.booking_ref)) %>" 
                  alt="Admission QR Code" 
                  onerror="this.src='https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=<%= encodeURIComponent(t.ticket_number || t.booking_ref) %>'"
                >
              </div>
              <div class="text-muted font-monospace mt-1" style="font-size: 0.62rem; color: #64748b;">
                Scan at Turnstile Gate
              </div>
            </div>
          </div>

          <div style="border-top: 1px dashed #cbd5e1; margin: 12px 0;"></div>

          <div class="row text-center align-items-center py-1">
            <div class="col-4 border-end border-light-subtle">
              <div class="text-muted text-uppercase fw-semibold" style="font-size: 0.65rem; letter-spacing: 0.05em;">Seat Assigned</div>
              <div class="ticket-seat-badge mt-0.5"><%= t.seat_code || (t.row_label && t.seat_number ? (t.row_label + t.seat_number) : (booking.seats_list || 'General')) %></div>
              <div class="badge bg-light text-dark border border-secondary-subtle mt-0.5" style="font-size: 0.62rem;"><%= t.seat_category || t.seat_type || 'STANDARD' %></div>
            </div>
            <div class="col-4 border-end border-light-subtle">
              <div class="text-muted text-uppercase fw-semibold" style="font-size: 0.65rem; letter-spacing: 0.05em;">Attendee</div>
              <div class="fw-bold text-dark mt-0.5 text-truncate px-1" style="font-size: 0.78rem;"><%= t.customer_name || booking.customer_name || 'Verified Patron' %></div>
              <div class="text-muted text-truncate" style="font-size: 0.65rem;"><%= t.customer_phone || booking.customer_phone || t.customer_email || booking.customer_email || 'patron@cinema.com' %></div>
            </div>
            <div class="col-4">
              <div class="text-muted text-uppercase fw-semibold" style="font-size: 0.65rem; letter-spacing: 0.05em;">Amount &amp; Ref</div>
              <div class="fw-bold text-success mt-0.5" style="font-size: 0.98rem; font-family: 'JetBrains Mono', monospace;">
                ₹<%= Number(t.price_paid || t.price || (booking.total_amount / (totalCount || 1)) || 0).toFixed(2) %>
              </div>
              <div class="text-muted font-monospace text-truncate" style="font-size: 0.62rem;">Ref: <%= t.booking_ref || booking.booking_ref %></div>
            </div>
          </div>

          <div class="mt-2 pt-2 border-top text-center text-muted" style="font-size: 0.65rem; color: #94a3b8;">
            &bull; Please arrive 15 minutes before showtime. Outside food &amp; beverages are strictly prohibited.
          </div>
        </div>
      </div>
    <% } %>
  </div>

</body>

</html>
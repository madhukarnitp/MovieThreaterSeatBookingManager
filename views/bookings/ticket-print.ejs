<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ticket - <%= ticket.ticket_number %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-ticket: #ffffff;
      --text-main: #0f172a;
      --text-muted: #64748b;
      --border-color: #e2e8f0;
      --primary-accent: #0f172a;
      --highlight: #d97706;
    }

    * {
      box-sizing: border-box;
    }

    body {
      background-color: #0b0f19;
      color: var(--text-main);
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      margin: 0;
      padding: 0;
      -webkit-print-color-adjust: exact !important;
      print-color-adjust: exact !important;
    }

    .ticket-wrapper {
      max-width: 650px;
      margin: 30px auto;
      padding: 0 15px;
    }

    .ticket-container {
      background: var(--bg-ticket);
      border-radius: 20px;
      box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.4);
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.1);
      position: relative;
    }

    /* Notch styling for authentic cinema ticket appearance */
    .ticket-container::before, .ticket-container::after {
      content: '';
      position: absolute;
      top: 140px;
      width: 24px;
      height: 24px;
      background-color: #0b0f19;
      border-radius: 50%;
      z-index: 2;
    }
    .ticket-container::before {
      left: -12px;
    }
    .ticket-container::after {
      right: -12px;
    }

    .ticket-header {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      color: #ffffff;
      padding: 22px 28px;
      border-bottom: 2px dashed #334155;
    }

    .ticket-body {
      padding: 26px 28px;
      background: #ffffff;
    }

    .ticket-seat-badge {
      font-size: 2.2rem;
      font-weight: 800;
      color: #d97706;
      font-family: 'JetBrains Mono', monospace;
      line-height: 1.1;
    }

    .qr-frame {
      background: #ffffff;
      padding: 10px;
      border-radius: 12px;
      border: 1px solid #e2e8f0;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
      display: inline-block;
    }

    .qr-frame img {
      width: 125px;
      height: 125px;
      object-fit: contain;
      display: block;
    }

    /* Print Specific Media Styles */
    @media print {
      body {
        background-color: #ffffff !important;
        color: #000000 !important;
      }
      .no-print {
        display: none !important;
      }
      .ticket-wrapper {
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
      }
      .ticket-container {
        box-shadow: none !important;
        border: 2px dashed #475569 !important;
        border-radius: 12px !important;
        margin: 0 auto !important;
        page-break-inside: avoid;
      }
      .ticket-container::before, .ticket-container::after {
        display: none !important;
      }
      .ticket-header {
        background: #0f172a !important;
        color: #ffffff !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
      .badge {
        border: 1px solid #000000 !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }
    }
  </style>
</head>
<body>

<div class="ticket-wrapper">
  <!-- Top Action Controls -->
  <div class="text-center mb-4 no-print d-flex justify-content-center gap-2">
    <button onclick="window.print()" class="btn btn-warning rounded-pill px-4 fw-bold shadow-sm">
      <i class="bi bi-printer-fill me-1.5"></i> Print Ticket
    </button>
    <a href="/bookings/<%= ticket.booking_id %>/tickets" class="btn btn-outline-light rounded-pill px-4 fw-medium">
      <i class="bi bi-arrow-left me-1"></i> Back to Booking
    </a>
    <a href="/customer/tickets" class="btn btn-outline-secondary rounded-pill px-3 fw-medium">
      <i class="bi bi-collection me-1"></i> All My Tickets
    </a>
  </div>

  <!-- Printable Cinema Boarding Pass Ticket -->
  <div class="ticket-container">
    <div class="ticket-header d-flex justify-content-between align-items-center">
      <div>
        <div class="d-flex align-items-center gap-2">
          <i class="bi bi-ticket-perforated-fill text-warning fs-5"></i>
          <span class="fw-bold tracking-wider text-uppercase" style="letter-spacing: 0.1em; font-size: 0.95rem;">Cinema Admission Pass</span>
        </div>
        <small class="text-slate-400 d-block mt-0.5" style="color: #94a3b8; font-size: 0.75rem;">Official Digital Entry Voucher</small>
      </div>
      <div class="text-end">
        <span class="badge bg-warning text-dark font-monospace fw-bold px-2.5 py-1.5" style="font-size: 0.85rem;">
          <%= ticket.ticket_number %>
        </span>
      </div>
    </div>

    <div class="ticket-body">
      <div class="row align-items-center mb-4">
        <div class="col-7 col-sm-8">
          <h2 class="fw-bold mb-1 text-dark" style="font-size: 1.5rem;"><%= ticket.movie_title %></h2>
          <p class="text-muted mb-2.5" style="font-size: 0.9rem;">
            <strong class="text-dark"><%= ticket.theater_name %></strong> &bull; <%= ticket.screen_name %>
          </p>
          <div class="d-flex flex-wrap gap-1.5 mb-2.5">
            <span class="badge bg-dark"><%= ticket.certification %></span>
            <span class="badge bg-secondary"><%= ticket.format %></span>
            <span class="badge bg-secondary"><%= ticket.language %></span>
            <span class="badge <%= ticket.ticket_status === 'valid' ? 'bg-success' : (ticket.ticket_status === 'used' ? 'bg-secondary' : 'bg-danger') %>">
              <%= ticket.ticket_status.toUpperCase() %>
            </span>
          </div>
          <div class="text-muted fw-semibold" style="font-size: 0.85rem;">
            <i class="bi bi-calendar-check text-warning me-1.5"></i>
            <%= new Date(ticket.start_time).toLocaleString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
          </div>
        </div>

        <div class="col-5 col-sm-4 text-center">
          <div class="qr-frame">
            <img 
              src="<%= ticket.qr_code_path %>" 
              alt="Admission QR Code" 
              onerror="this.src='https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=<%= encodeURIComponent(ticket.ticket_number) %>'"
            >
          </div>
          <div class="text-muted font-monospace mt-1.5" style="font-size: 0.7rem; color: #64748b;">
            Scan at Turnstile Gate
          </div>
        </div>
      </div>

      <div style="border-top: 1px dashed #cbd5e1; margin: 16px 0;"></div>

      <div class="row text-center align-items-center py-2">
        <div class="col-4 border-end border-light-subtle">
          <div class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Seat Assigned</div>
          <div class="ticket-seat-badge mt-1"><%= ticket.row_label %><%= ticket.seat_number %></div>
          <div class="badge bg-light text-dark border border-secondary-subtle mt-0.5" style="font-size: 0.7rem;"><%= ticket.seat_category %></div>
        </div>
        <div class="col-4 border-end border-light-subtle">
          <div class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Attendee</div>
          <div class="fw-bold text-dark mt-1 text-truncate px-1" style="font-size: 0.9rem;"><%= ticket.customer_name %></div>
          <div class="text-muted text-truncate" style="font-size: 0.75rem;"><%= ticket.customer_phone || ticket.customer_email %></div>
        </div>
        <div class="col-4">
          <div class="text-muted text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.05em;">Amount & Ref</div>
          <div class="fw-bold text-success mt-1" style="font-size: 1.15rem; font-family: 'JetBrains Mono', monospace;">₹<%= Number(ticket.price_paid).toFixed(2) %></div>
          <div class="text-muted font-monospace text-truncate" style="font-size: 0.72rem;">Ref: <%= ticket.booking_ref %></div>
        </div>
      </div>

      <div class="mt-3 pt-3 border-top text-center text-muted" style="font-size: 0.72rem; color: #94a3b8;">
        &bull; Please arrive 15 minutes before showtime. Outside food & beverages are strictly prohibited.
      </div>
    </div>
  </div>
</div>

</body>
</html>
<%- include('../partials/header') %>

<div class="container py-4">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
      <li class="breadcrumb-item"><a href="/" class="text-secondary text-decoration-none">Home</a></li>
      <li class="breadcrumb-item"><a href="/movies" class="text-secondary text-decoration-none">Movies</a></li>
      <li class="breadcrumb-item"><a href="/movies/<%= showtime.movie_id %>" class="text-secondary text-decoration-none"><%= showtime.movie_title %></a></li>
      <li class="breadcrumb-item active text-warning" aria-current="page">Select Seats</li>
    </ol>
  </nav>

  <!-- Showtime Summary Bar -->
  <div class="card bg-dark border-secondary border-opacity-25 rounded-4 shadow-lg mb-4 p-3 p-md-4">
    <div class="row align-items-center g-3">
      <div class="col-auto">
        <img 
          src="<%= showtime.poster_path %>" 
          alt="<%= showtime.movie_title %>" 
          class="rounded-3 shadow"
          style="width: 70px; height: 100px; object-fit: cover;"
          onerror="this.src='/images/posters/fallback.svg'"
        >
      </div>
      <div class="col">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
          <h4 class="text-white fw-bold mb-0"><%= showtime.movie_title %></h4>
          <span class="badge text-bg-warning fw-bold"><%= showtime.certification %></span>
          <span class="badge bg-secondary-subtle text-light"><%= showtime.format %></span>
          <span class="badge bg-secondary-subtle text-light"><%= showtime.language %></span>
        </div>
        <p class="text-secondary mb-1">
          <i class="bi bi-geo-alt text-warning me-1"></i><strong><%= showtime.theater_name %></strong> (<%= showtime.city %>) &bull; <span class="text-light"><%= showtime.screen_name %></span>
        </p>
        <p class="text-warning small mb-0 fw-semibold">
          <i class="bi bi-clock me-1"></i><%= showtime.formatted_datetime || (showtime.show_date + ' ' + showtime.start_time) %>
        </p>
      </div>
      <div class="col-md-auto text-md-end">
        <a href="/movies/<%= showtime.movie_id %>/showtimes" class="btn btn-outline-secondary btn-sm rounded-pill">
          <i class="bi bi-arrow-left me-1"></i> Change Showtime
        </a>
      </div>
    </div>
  </div>

  <!-- Legend & Pricing Cards -->
  <div class="card bg-dark border-secondary border-opacity-25 rounded-4 p-3 mb-4">
    <div class="row g-3 align-items-center justify-content-between">
      <!-- Seat Category Legend -->
      <div class="col-lg-6">
        <div class="d-flex flex-wrap gap-4 align-items-center">
          <div class="d-flex align-items-center gap-2">
            <span class="seat-badge available"></span>
            <span class="small text-light">Available</span>
          </div>
          <div class="d-flex align-items-center gap-2">
            <span class="seat-badge selected"></span>
            <span class="small text-light">Selected</span>
          </div>
          <div class="d-flex align-items-center gap-2">
            <span class="seat-badge held"></span>
            <span class="small text-light">Held</span>
          </div>
          <div class="d-flex align-items-center gap-2">
            <span class="seat-badge booked"></span>
            <span class="small text-light">Booked</span>
          </div>
          <div class="d-flex align-items-center gap-2">
            <span class="seat-badge blocked"></span>
            <span class="small text-light">Unavailable</span>
          </div>
        </div>
      </div>
      <!-- Tier Prices -->
      <div class="col-lg-6">
        <div class="d-flex flex-wrap gap-3 justify-content-lg-end">
          <% seatTypes.forEach(function(type) { %>
            <div class="category-price-pill px-3 py-1 rounded-pill bg-black border border-secondary border-opacity-50 small">
              <span class="text-secondary"><%= type.name %>:</span>
              <span class="text-warning fw-bold ms-1">₹<%= type.calculated_price %></span>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <!-- Main Seat Matrix Section -->
    <div class="col-lg-8">
      <div class="card bg-dark border-secondary border-opacity-25 rounded-4 p-4 shadow-lg text-center position-relative">
        
        <!-- Live Polling Indicator -->
        <div class="position-absolute top-0 end-0 m-3 d-flex align-items-center gap-2">
          <span class="pulse-indicator"></span>
          <span class="text-secondary small" style="font-size: 0.75rem;">Live Availability</span>
        </div>

        <!-- Cinema Screen Curve Indicator -->
        <div class="cinema-screen-container mb-5 mt-2">
          <div class="cinema-screen"></div>
          <div class="cinema-screen-text text-uppercase small text-secondary tracking-widest mt-2 fw-semibold">
            All eyes this way &bull; SCREEN
          </div>
        </div>

        <!-- Seat Grid Layout -->
        <div class="seat-matrix-wrapper overflow-auto py-2 mb-3">
          <div class="seat-matrix d-inline-block">
            <% Object.keys(rows).sort().forEach(function(rowLabel) { %>
              <div class="seat-row d-flex align-items-center justify-content-center gap-1 mb-2">
                <span class="row-label me-2 text-secondary fw-bold"><%= rowLabel %></span>
                
                <% rows[rowLabel].forEach(function(seat) { %>
                  <button 
                    type="button"
                    class="cinema-seat seat-<%= seat.status %> <%= seat.isMyHold ? 'is-my-hold' : '' %>"
                    data-seat-id="<%= seat.seatId %>"
                    data-seat-code="<%= seat.seatCode %>"
                    data-category="<%= seat.categoryName %>"
                    data-price="<%= seat.price %>"
                    data-status="<%= seat.status %>"
                    title="<%= seat.seatCode %> (<%= seat.categoryName %>) - ₹<%= seat.price %> [<%= seat.status %>]"
                    <%= (seat.status !== 'available' && !seat.isMyHold) ? 'disabled' : '' %>
                  >
                    <%= seat.seatNumber %>
                  </button>
                <% }); %>

                <span class="row-label ms-2 text-secondary fw-bold"><%= rowLabel %></span>
              </div>
            <% }); %>
          </div>
        </div>

        <div class="alert alert-info bg-opacity-10 border-info border-opacity-25 text-info py-2 small mb-0">
          <i class="bi bi-info-circle me-1"></i> You can select up to 10 seats per booking. Seats will be held for 10 minutes upon continuing.
        </div>
      </div>
    </div>

    <!-- Booking Summary Sidebar -->
    <div class="col-lg-4">
      <div class="card bg-dark border-secondary border-opacity-25 rounded-4 p-4 shadow-lg sticky-top" style="top: 85px;">
        <h5 class="text-white fw-bold mb-3 border-bottom border-secondary border-opacity-25 pb-2">
          <i class="bi bi-ticket-perforated text-warning me-2"></i>Booking Summary
        </h5>

        <div class="mb-3">
          <div class="text-secondary small mb-1">Selected Seats (<span id="selected-count">0</span>):</div>
          <div id="selected-seats-container" class="d-flex flex-wrap gap-2 min-h-seat-pill">
            <span class="text-secondary small fst-italic py-1" id="no-seats-text">No seats selected yet</span>
          </div>
        </div>

        <hr class="border-secondary border-opacity-25">

        <!-- Price Breakdown -->
        <div class="price-breakdown mb-3">
          <div class="d-flex justify-content-between text-secondary small mb-2">
            <span>Ticket Subtotal</span>
            <span class="text-white fw-semibold" id="subtotal-amount">₹0.00</span>
          </div>
          <div class="d-flex justify-content-between text-secondary small mb-2">
            <span>Convenience Fee</span>
            <span class="text-success fw-semibold">₹0.00 (Free)</span>
          </div>
          <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary border-opacity-25">
            <span class="text-white fw-bold fs-5">Total Amount</span>
            <span class="text-warning fw-bold fs-4" id="total-amount">₹0.00</span>
          </div>
        </div>

        <!-- Reserve Form -->
        <% if (currentUser) { %>
          <form action="/bookings/hold" method="POST" id="reserve-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="showtime_id" value="<%= showtime.showtime_id %>">
            <input type="hidden" name="seat_ids" id="hidden-seat-ids" value="[]">

            <button type="submit" id="btn-proceed" class="btn btn-warning w-100 py-3 rounded-pill fw-bold fs-6 shadow-sm" disabled>
              <i class="bi bi-lock-fill me-1"></i> Proceed to Payment
            </button>
          </form>
        <% } else { %>
          <div class="alert alert-dark border-warning border-opacity-25 text-warning p-3 rounded-3 small mb-3">
            <i class="bi bi-exclamation-triangle me-1"></i> Please log in to your customer account to reserve seats.
          </div>
          <a href="/auth/login?returnTo=<%= encodeURIComponent('/showtimes/' + showtime.showtime_id + '/seats') %>" class="btn btn-warning w-100 py-3 rounded-pill fw-bold">
            <i class="bi bi-box-arrow-in-right me-1"></i> Login to Book Seats
          </a>
        <% } %>

        <div class="text-center mt-3">
          <small class="text-secondary">
            <i class="bi bi-shield-check text-success me-1"></i> 100% Safe & Secure Checkout
          </small>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="/js/seat-selection.js"></script>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<div class="container py-4">
  <!-- Breadcrumb -->
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
      <li class="breadcrumb-item"><a href="/" class="text-secondary text-decoration-none">Home</a></li>
      <li class="breadcrumb-item"><a href="/customer/bookings" class="text-secondary text-decoration-none">My Bookings</a></li>
      <li class="breadcrumb-item active text-warning" aria-current="page">Booking <%= booking.booking_ref %></li>
    </ol>
  </nav>

  <!-- Success Notification Header -->
  <div class="card bg-success bg-opacity-10 border border-success border-opacity-50 rounded-4 p-4 shadow-sm mb-4 text-center">
    <div class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-circle mb-3 shadow" style="width: 56px; height: 56px; font-size: 1.8rem;">
      <i class="bi bi-check-lg"></i>
    </div>
    <h3 class="text-white fw-bold mb-1">Booking Confirmed!</h3>
    <p class="text-secondary mb-3">
      Your tickets have been issued successfully. Present the QR code at cinema admission.
    </p>
    <div class="d-flex flex-wrap justify-content-center gap-3">
      <button onclick="window.print()" class="btn btn-warning rounded-pill px-4 fw-semibold">
        <i class="bi bi-printer me-2"></i>Print All Tickets
      </button>
      <a href="/customer/bookings" class="btn btn-outline-light rounded-pill px-4">
        <i class="bi bi-clock-history me-2"></i>My Bookings
      </a>
      <a href="/movies" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="bi bi-camera-reels me-2"></i>Browse More Movies
      </a>
    </div>
  </div>

  <!-- Booking Metadata & Payment Summary -->
  <div class="card bg-dark border-secondary border-opacity-25 rounded-4 p-4 shadow-lg mb-4">
    <div class="row g-4 align-items-center">
      <div class="col-sm-auto text-center">
        <img 
          src="<%= booking.poster_path %>" 
          alt="<%= booking.movie_title %>" 
          class="rounded-3 shadow"
          style="width: 100px; height: 145px; object-fit: cover;"
          onerror="this.src='/images/posters/fallback.svg'"
        >
      </div>
      <div class="col">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
          <h4 class="text-white fw-bold mb-0"><%= booking.movie_title %></h4>
          <span class="badge text-bg-warning fw-bold"><%= booking.certification %></span>
          <span class="badge bg-secondary-subtle text-light"><%= booking.format %></span>
          <span class="badge bg-secondary-subtle text-light"><%= booking.language %></span>
        </div>
        <p class="text-secondary small mb-1">
          <i class="bi bi-geo-alt text-warning me-1"></i><strong><%= booking.theater_name %></strong> &bull; <%= booking.screen_name %> (<%= booking.city %>)
        </p>
        <p class="text-warning small mb-1 fw-semibold">
          <i class="bi bi-clock me-1"></i><%= new Date(booking.start_time).toLocaleString('en-US', { weekday: 'short', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
        </p>
        <div class="d-flex flex-wrap gap-3 small text-secondary">
          <span><i class="bi bi-person me-1"></i><%= booking.customer_name %></span>
          <span><i class="bi bi-receipt me-1"></i>Ref: <strong class="text-light font-monospace"><%= booking.booking_ref %></strong></span>
          <span><i class="bi bi-cash-stack me-1"></i>Paid: <strong class="text-success">₹<%= Number(booking.total_amount).toFixed(2) %></strong></span>
          <% if (booking.transaction_ref) { %>
            <span><i class="bi bi-credit-card me-1"></i>Txn: <span class="font-monospace text-light"><%= booking.transaction_ref %></span></span>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Individual Ticket Cards Grid -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="text-white fw-bold mb-0">
      <i class="bi bi-ticket-perforated-fill text-warning me-2"></i>Issued Tickets (<%= booking.tickets.length %>)
    </h5>
    <button onclick="window.print()" class="btn btn-outline-warning btn-sm rounded-pill px-3">
      <i class="bi bi-printer me-1"></i> Print All Tickets
    </button>
  </div>

  <div class="row g-4 mb-4">
    <% booking.tickets.forEach(function(t, idx) { %>
      <div class="col-md-6 col-lg-4">
        <div class="ticket-card bg-black border border-warning border-opacity-50 rounded-4 overflow-hidden shadow-lg p-3 position-relative">
          
          <!-- Top Ticket Header -->
          <div class="d-flex justify-content-between align-items-center border-bottom border-secondary border-opacity-50 pb-2 mb-3">
            <span class="badge bg-warning text-dark fw-bold font-monospace">
              <%= t.ticket_number %>
            </span>
            <span class="badge <%= t.ticket_status === 'valid' ? 'bg-success' : (t.ticket_status === 'used' ? 'bg-secondary' : 'bg-danger') %> text-uppercase small">
              <%= t.ticket_status %>
            </span>
          </div>

          <!-- QR Code and Seat Highlight -->
          <div class="row g-2 align-items-center mb-3">
            <div class="col-auto">
              <div class="bg-white p-2 rounded-3 text-center shadow-sm" style="width: 110px; height: 110px;">
                <img 
                  src="<%= t.qr_code_path %>" 
                  alt="QR Code" 
                  class="img-fluid w-100 h-100 object-fit-contain"
                  onerror="this.src='https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=<%= encodeURIComponent(t.ticket_number) %>'"
                >
              </div>
            </div>
            <div class="col text-center">
              <div class="text-secondary small text-uppercase">Seat Number</div>
              <div class="display-6 fw-bold text-warning mb-0 font-monospace">
                <%= t.row_label %><%= t.seat_number %>
              </div>
              <div class="badge bg-secondary-subtle text-light small"><%= t.seat_category %></div>
              <div class="text-secondary small mt-1">₹<%= Number(t.price_paid).toFixed(2) %></div>
            </div>
          </div>

          <!-- Bottom Meta -->
          <div class="border-top border-secondary border-opacity-50 pt-2 small text-secondary">
            <div class="text-truncate text-white fw-semibold mb-1"><%= booking.movie_title %></div>
            <div class="d-flex justify-content-between align-items-center">
              <span><%= booking.screen_name %></span>
              <a href="/tickets/<%= t.ticket_number %>" target="_blank" class="btn btn-outline-warning btn-sm rounded-pill px-2.5 py-0.5 text-xs text-decoration-none fw-semibold">
                <i class="bi bi-printer me-1"></i>Print Pass
              </a>
            </div>
          </div>
        </div>
      </div>
    <% }); %>
  </div>

  <!-- Payment Audit History -->
  <% if (booking.payments && booking.payments.length > 0) { %>
    <div class="card bg-dark border-secondary border-opacity-25 rounded-4 p-4 shadow-lg">
      <h6 class="text-white fw-bold mb-3">
        <i class="bi bi-clock-history text-warning me-2"></i>Payment Transaction Log
      </h6>
      <div class="table-responsive">
        <table class="table table-dark table-hover table-bordered border-secondary border-opacity-25 small align-middle mb-0">
          <thead class="table-secondary text-uppercase text-secondary">
            <tr>
              <th>Txn Reference</th>
              <th>Method</th>
              <th>Amount</th>
              <th>Status</th>
              <th>Date & Time</th>
            </tr>
          </thead>
          <tbody>
            <% booking.payments.forEach(function(p) { %>
              <tr>
                <td class="font-monospace"><%= p.transaction_ref %></td>
                <td class="text-uppercase"><%= p.payment_method %></td>
                <td class="text-light fw-bold">₹<%= Number(p.amount).toFixed(2) %></td>
                <td>
                  <span class="badge <%= p.status === 'success' ? 'bg-success' : 'bg-danger' %> text-uppercase">
                    <%= p.status %>
                  </span>
                </td>
                <td class="text-secondary"><%= new Date(p.created_at).toLocaleString() %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>

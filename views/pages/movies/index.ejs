<%- include('../../partials/header') %>

<div class="container py-5">
  <!-- Header Title -->
  <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-3">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1 small">
          <li class="breadcrumb-item"><a href="/" class="text-secondary text-decoration-none">Home</a></li>
          <li class="breadcrumb-item active text-warning" aria-current="page">Movies</li>
        </ol>
      </nav>
      <h1 class="display-6 fw-bold text-white mb-0">Browse Movies</h1>
      <p class="text-secondary small mb-0">Discover now showing blockbusters, upcoming previews, and theater schedules</p>
    </div>

    <div>
      <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-2 rounded-pill fs-6">
        <i class="bi bi-film me-1"></i> <%= totalCount %> Movie<%= totalCount === 1 ? '' : 's' %> Found
      </span>
    </div>
  </div>

  <!-- Search & Filter Controls Card -->
  <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle rounded-4 p-4 mb-4 shadow-sm">
    <form action="/movies" method="GET" id="movieFilterForm">
      <div class="row g-3 align-items-center">
        <!-- Search Input -->
        <div class="col-lg-4 col-md-6">
          <label for="searchInput" class="form-label text-secondary small fw-semibold mb-1">Search Title</label>
          <div class="input-group">
            <span class="input-group-text bg-dark border-secondary-subtle text-secondary">
              <i class="bi bi-search text-warning"></i>
            </span>
            <input 
              type="text" 
              id="searchInput"
              name="search" 
              class="form-control bg-dark text-light border-secondary-subtle" 
              placeholder="Movie title, keyword..."
              value="<%= filters.search %>"
            >
          </div>
        </div>

        <!-- Genre Filter -->
        <div class="col-lg-2 col-md-3 col-6">
          <label for="genreSelect" class="form-label text-secondary small fw-semibold mb-1">Genre</label>
          <select id="genreSelect" name="genre" class="form-select bg-dark text-light border-secondary-subtle" onchange="this.form.submit()">
            <option value="all" <%= filters.genre === 'all' ? 'selected' : '' %>>All Genres</option>
            <% if (filterOptions && filterOptions.genres) { %>
              <% filterOptions.genres.forEach(function(g) { %>
                <option value="<%= g.slug %>" <%= filters.genre.toLowerCase() === g.slug.toLowerCase() ? 'selected' : '' %>>
                  <%= g.name %>
                </option>
              <% }); %>
            <% } %>
          </select>
        </div>

        <!-- Language Filter -->
        <div class="col-lg-2 col-md-3 col-6">
          <label for="langSelect" class="form-label text-secondary small fw-semibold mb-1">Language</label>
          <select id="langSelect" name="language" class="form-select bg-dark text-light border-secondary-subtle" onchange="this.form.submit()">
            <option value="all" <%= filters.language === 'all' ? 'selected' : '' %>>All Languages</option>
            <% if (filterOptions && filterOptions.languages) { %>
              <% filterOptions.languages.forEach(function(lang) { %>
                <option value="<%= lang %>" <%= filters.language.toLowerCase() === lang.toLowerCase() ? 'selected' : '' %>>
                  <%= lang %>
                </option>
              <% }); %>
            <% } %>
          </select>
        </div>

        <!-- Status Filter -->
        <div class="col-lg-2 col-md-6 col-6">
          <label for="statusSelect" class="form-label text-secondary small fw-semibold mb-1">Status</label>
          <select id="statusSelect" name="status" class="form-select bg-dark text-light border-secondary-subtle" onchange="this.form.submit()">
            <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All Statuses</option>
            <option value="now_showing" <%= filters.status === 'now_showing' ? 'selected' : '' %>>Now Showing</option>
            <option value="upcoming" <%= filters.status === 'upcoming' ? 'selected' : '' %>>Upcoming</option>
            <option value="ended" <%= filters.status === 'ended' ? 'selected' : '' %>>Past Releases</option>
          </select>
        </div>

        <!-- Sort Option -->
        <div class="col-lg-2 col-md-6 col-6">
          <label for="sortSelect" class="form-label text-secondary small fw-semibold mb-1">Sort By</label>
          <select id="sortSelect" name="sort" class="form-select bg-dark text-light border-secondary-subtle" onchange="this.form.submit()">
            <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Newest First</option>
            <option value="title_asc" <%= filters.sort === 'title_asc' ? 'selected' : '' %>>Title (A-Z)</option>
            <option value="title_desc" <%= filters.sort === 'title_desc' ? 'selected' : '' %>>Title (Z-A)</option>
            <option value="duration_desc" <%= filters.sort === 'duration_desc' ? 'selected' : '' %>>Duration (Longest)</option>
          </select>
        </div>
      </div>

      <!-- Quick Filter Pills & Clear -->
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3 pt-3 border-top border-secondary-subtle">
        <div class="d-flex flex-wrap gap-2 align-items-center">
          <span class="text-secondary small me-1">Quick Filter:</span>
          <a href="/movies?status=now_showing" class="btn btn-sm <%= filters.status === 'now_showing' ? 'btn-warning' : 'btn-outline-secondary' %> rounded-pill">
            <i class="bi bi-play-circle me-1"></i> Now Showing
          </a>
          <a href="/movies?status=upcoming" class="btn btn-sm <%= filters.status === 'upcoming' ? 'btn-info text-dark' : 'btn-outline-secondary' %> rounded-pill">
            <i class="bi bi-stars me-1"></i> Upcoming
          </a>
          <% if (filterOptions && filterOptions.genres) { %>
            <% filterOptions.genres.slice(0, 4).forEach(function(g) { %>
              <a href="/movies?genre=<%= g.slug %>" class="btn btn-sm <%= filters.genre.toLowerCase() === g.slug.toLowerCase() ? 'btn-light' : 'btn-outline-secondary' %> rounded-pill">
                <%= g.name %>
              </a>
            <% }); %>
          <% } %>
        </div>

        <% if (filters.search || filters.genre !== 'all' || filters.language !== 'all' || filters.status !== 'all' || filters.sort !== 'newest') { %>
          <a href="/movies" class="btn btn-link text-danger text-decoration-none small p-0">
            <i class="bi bi-x-circle me-1"></i> Reset Filters
          </a>
        <% } %>
      </div>
    </form>
  </div>

  <!-- Movie Cards Grid -->
  <% if (movies && movies.length > 0) { %>
    <div class="row g-4 mb-5">
      <% movies.forEach(function(movie) { %>
        <div class="col-6 col-md-4 col-lg-3">
          <div class="movie-card h-100 d-flex flex-column">
            <!-- Poster -->
            <div class="movie-poster-wrapper">
              <img 
                src="<%= movie.poster_path %>" 
                alt="<%= movie.title %>" 
                class="movie-poster-img"
                loading="lazy"
                onerror="this.src='/images/posters/fallback.svg'"
              >
              <div class="poster-overlay-top">
                <span class="badge text-bg-dark border border-secondary-subtle fw-semibold">
                  <%= movie.certification %>
                </span>
                <% if (movie.status === 'upcoming') { %>
                  <span class="badge text-bg-info text-dark fw-bold">Coming Soon</span>
                <% } else if (movie.formatList && movie.formatList.length > 0) { %>
                  <span class="badge text-bg-warning text-dark fw-bold"><%= movie.formatList[0] %></span>
                <% } %>
              </div>
              <div class="poster-overlay-bottom">
                <span class="text-white small fw-bold">
                  <i class="bi bi-clock me-1"></i><%= movie.formattedDuration %>
                </span>
              </div>
            </div>

            <!-- Card Body -->
            <div class="card-body p-3 d-flex flex-column flex-grow-1">
              <h5 class="fw-bold text-white text-truncate mb-1" title="<%= movie.title %>">
                <a href="/movies/<%= movie.movie_id %>" class="text-white text-decoration-none hover-light">
                  <%= movie.title %>
                </a>
              </h5>

              <div class="small text-secondary text-truncate mb-2">
                <%= movie.genres || movie.language %>
              </div>

              <div class="small text-secondary mb-3">
                <i class="bi bi-calendar3 me-1"></i> Released: <%= new Date(movie.release_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
              </div>

              <!-- Action Buttons -->
              <div class="mt-auto d-flex gap-2">
                <% if (movie.status === 'now_showing') { %>
                  <a href="/movies/<%= movie.movie_id %>/showtimes" class="btn btn-warning btn-sm flex-grow-1 fw-semibold rounded-pill">
                    <i class="bi bi-ticket-perforated me-1"></i> Book
                  </a>
                <% } else if (movie.status === 'upcoming') { %>
                  <a href="/movies/<%= movie.movie_id %>" class="btn btn-outline-info btn-sm flex-grow-1 rounded-pill">
                    <i class="bi bi-bell me-1"></i> Details
                  </a>
                <% } else { %>
                  <a href="/movies/<%= movie.movie_id %>" class="btn btn-outline-secondary btn-sm flex-grow-1 rounded-pill text-light">
                    <i class="bi bi-info-circle me-1"></i> Archival
                  </a>
                <% } %>

                <a href="/movies/<%= movie.movie_id %>" class="btn btn-outline-secondary btn-sm rounded-pill px-3 text-light" title="View details">
                  <i class="bi bi-eye"></i>
                </a>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <!-- Empty State -->
    <div class="text-center py-5 my-5">
      <div class="display-3 text-secondary opacity-50 mb-3">
        <i class="bi bi-search"></i>
      </div>
      <h3 class="fw-bold text-white mb-2">No Movies Found</h3>
      <p class="text-secondary mb-4" style="max-width: 480px; margin: 0 auto;">
        We couldn't find any movie matching your current search query or filter selection.
      </p>
      <a href="/movies" class="btn btn-warning px-4 rounded-pill fw-semibold">
        <i class="bi bi-arrow-counterclockwise me-1"></i> Clear All Filters
      </a>
    </div>
  <% } %>
</div>

<%- include('../../partials/footer') %>

<%- include('../../partials/header') %>

<div class="container py-5">
  <!-- Header & Selected Movie Overview -->
  <div class="p-4 p-md-5 mb-5 rounded-4 bg-secondary bg-opacity-10 border border-secondary-subtle">
    <div class="row align-items-center g-4">
      <% if (movie) { %>
        <div class="col-md-2 text-center text-md-start">
          <div style="aspect-ratio: 2/3; max-width: 140px;" class="rounded-3 overflow-hidden shadow mx-auto">
            <img 
              src="<%= movie.poster_path %>" 
              alt="<%= movie.title %>" 
              class="w-100 h-100 object-fit-cover"
              onerror="this.src='/images/posters/fallback.svg'"
            >
          </div>
        </div>
        <div class="col-md-7">
          <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge text-bg-warning fw-bold"><%= movie.certification %></span>
            <span class="badge bg-secondary-subtle text-light border border-secondary-subtle"><%= movie.formattedDuration %></span>
            <span class="text-secondary small"><%= movie.language %></span>
          </div>
          <h2 class="fw-bold text-white mb-2"><%= movie.title %></h2>
          <p class="text-secondary small mb-0"><%= movie.genres %></p>
        </div>
        <div class="col-md-3 text-md-end">
          <a href="/movies/<%= movie.movie_id %>" class="btn btn-outline-light btn-sm rounded-pill px-3">
            <i class="bi bi-info-circle me-1"></i> Movie Synopsis
          </a>
        </div>
      <% } else { %>
        <div class="col-12">
          <h2 class="fw-bold text-white mb-2">Select Showtime &amp; Cinema</h2>
          <p class="text-secondary mb-0">Choose your theater, screen preference, and showtime schedule</p>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Available Dates Bar -->
  <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle rounded-4 p-4 mb-4 shadow-sm">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
      <div class="d-flex align-items-center gap-2">
        <i class="bi bi-calendar3 text-warning fs-5"></i>
        <span class="fw-bold text-white">Select Date:</span>
      </div>

      <% if (showtimesData && showtimesData.availableDates && showtimesData.availableDates.length > 0) { %>
        <div class="d-flex gap-2 overflow-x-auto pb-1">
          <% showtimesData.availableDates.forEach(function(dateStr) { %>
            <% const dateObj = new Date(dateStr + 'T00:00:00'); %>
            <a 
              href="/movies/<%= movie ? movie.movie_id : '' %>/showtimes?date=<%= dateStr %>" 
              class="date-pill <%= selectedDate === dateStr ? 'active' : '' %>"
            >
              <span class="small text-uppercase"><%= dateObj.toLocaleDateString('en-US', { weekday: 'short' }) %></span>
              <span class="fs-5 fw-bold"><%= dateObj.getDate() %></span>
              <span class="small"><%= dateObj.toLocaleDateString('en-US', { month: 'short' }) %></span>
            </a>
          <% }); %>
        </div>
      <% } else { %>
        <span class="text-secondary small">No dates with active showtimes</span>
      <% } %>
    </div>
  </div>

  <!-- Theater Showtimes List -->
  <% if (showtimesData && selectedDate && showtimesData.grouped[selectedDate]) { %>
    <% const currentTheaters = showtimesData.grouped[selectedDate].theaters; %>
    <% const theaterIds = Object.keys(currentTheaters); %>

    <% if (theaterIds.length > 0) { %>
      <div class="d-flex flex-column gap-4 mb-5">
        <% theaterIds.forEach(function(tId) { %>
          <% const theater = currentTheaters[tId]; %>
          <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle rounded-4 p-4 shadow-sm hover-lift">
            <div class="row align-items-center g-4">
              <!-- Theater details -->
              <div class="col-lg-4 border-end-lg border-secondary-subtle">
                <div class="d-flex align-items-center gap-2 mb-2">
                  <div class="p-2 rounded-circle bg-danger bg-opacity-10 text-danger">
                    <i class="bi bi-geo-alt-fill"></i>
                  </div>
                  <h4 class="fw-bold text-white mb-0"><%= theater.name %></h4>
                </div>
                <p class="text-secondary small mb-3"><%= theater.address %>, <%= theater.city %></p>
                <div class="d-flex gap-2">
                  <span class="badge text-bg-dark border border-secondary-subtle"><i class="bi bi-shield-check me-1 text-success"></i> Verified Hall</span>
                  <span class="badge text-bg-dark border border-secondary-subtle"><i class="bi bi-p-circle me-1 text-info"></i> Valet Available</span>
                </div>
              </div>

              <!-- Available showtimes for this theater -->
              <div class="col-lg-8">
                <div class="d-flex flex-wrap gap-3">
                  <% theater.showtimes.forEach(function(st) { %>
                    <div class="showtime-chip p-3 <%= st.available_seats === 0 ? 'disabled' : '' %>">
                      <div class="fs-5 fw-bold text-white mb-1"><%= st.formattedTime %></div>
                      <div class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 small mb-1">
                        <%= st.format %> &bull; <%= st.screen_name %>
                      </div>
                      <div class="small text-secondary mb-2">₹<%= st.base_price %></div>

                      <% if (st.available_seats > 0) { %>
                        <div class="small text-success mb-2">
                          <i class="bi bi-check-circle me-1"></i><%= st.available_seats %> seats left
                        </div>
                        <a href="/showtimes/<%= st.showtime_id %>/seats" class="btn btn-warning btn-sm w-100 py-1 rounded-pill fw-semibold">
                          Book Seats
                        </a>
                      <% } else { %>
                        <div class="small text-danger mb-2">House Full</div>
                        <button class="btn btn-secondary btn-sm w-100 py-1 rounded-pill disabled" disabled>Sold Out</button>
                      <% } %>
                    </div>
                  <% }); %>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  <% } else { %>
    <div class="text-center py-5 bg-secondary bg-opacity-10 rounded-4 border border-secondary-subtle p-5 mb-5">
      <i class="bi bi-calendar-x display-3 text-secondary mb-3 d-block opacity-50"></i>
      <h4 class="text-white fw-bold mb-2">No Showtimes Scheduled</h4>
      <p class="text-secondary mb-4">Please select another date or check back later for schedule updates.</p>
      <a href="/movies" class="btn btn-warning rounded-pill px-4 fw-semibold">
        <i class="bi bi-camera-reels me-1"></i> Browse Movie Listings
      </a>
    </div>
  <% } %>
</div>

<%- include('../../partials/footer') %>

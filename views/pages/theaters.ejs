<%- include('../partials/header') %>

<div class="container py-5">
  <!-- Page Header -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-5 pb-3 border-bottom border-slate-800">
    <div>
      <span class="badge bg-amber-500/10 text-amber-400 border border-amber-500/20 px-3 py-1.5 rounded-full text-xs font-semibold tracking-wider uppercase mb-2">
        <i class="bi bi-buildings-fill me-1"></i> Theater Network
      </span>
      <h1 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight mt-1 mb-1">
        Cinema Complexes &amp; Auditoriums
      </h1>
      <p class="text-slate-400 text-sm mb-0">
        Browse our partner theaters, modern screens, seating capacities, and today's scheduled movie screenings.
      </p>
    </div>

    <!-- City Filter Form -->
    <form action="/theaters" method="GET" class="d-flex align-items-center gap-2">
      <div class="input-group">
        <span class="input-group-text bg-slate-900 border-slate-800 text-slate-400">
          <i class="bi bi-geo-alt"></i>
        </span>
        <select name="city" class="form-select bg-slate-900 text-slate-200 border-slate-800 rounded-r-xl text-sm" onchange="this.form.submit()">
          <option value="">All Cities</option>
          <% if (typeof cities !== 'undefined' && cities) { %>
            <% cities.forEach(function(c) { %>
              <option value="<%= c %>" <%= selectedCity === c ? 'selected' : '' %>><%= c %></option>
            <% }); %>
          <% } %>
        </select>
      </div>
      <% if (selectedCity) { %>
        <a href="/theaters" class="btn btn-outline-secondary btn-sm rounded-xl px-3 text-slate-300">
          Clear
        </a>
      <% } %>
    </form>
  </div>

  <!-- Theater Cards List -->
  <% if (theaters && theaters.length > 0) { %>
    <div class="row g-4">
      <% theaters.forEach(function(t) { %>
        <div class="col-lg-6">
          <div class="card h-100 bg-slate-900/90 border border-slate-800 rounded-2xl shadow-xl overflow-hidden hover:border-slate-700 transition-all duration-200">
            <!-- Theater Header Banner -->
            <div class="p-4 bg-gradient-to-r from-slate-950 via-slate-900 to-slate-950 border-b border-slate-800/80">
              <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                  <h3 class="text-xl font-bold text-white mb-1"><%= t.name %></h3>
                  <p class="text-slate-400 text-xs mb-0 d-flex align-items-center gap-1.5">
                    <i class="bi bi-geo-alt-fill text-amber-400"></i>
                    <%= t.address %>, <span class="text-amber-400 font-semibold"><%= t.city %></span>
                  </p>
                </div>
                <div class="text-end">
                  <span class="badge bg-amber-500/10 text-amber-400 border border-amber-500/30 px-3 py-1.5 rounded-xl font-semibold text-xs">
                    <i class="bi bi-display me-1"></i> <%= t.total_screens %> Screen<%= t.total_screens > 1 ? 's' : '' %>
                  </span>
                  <div class="text-[11px] text-slate-400 mt-1">
                    Total: <strong class="text-white"><%= t.total_capacity %></strong> seats
                  </div>
                </div>
              </div>
            </div>

            <!-- Body: Screens and Features -->
            <div class="p-4">
              <h6 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Auditoriums &amp; Screen Formats</h6>
              <div class="row g-2 mb-4">
                <% if (t.screens && t.screens.length > 0) { %>
                  <% t.screens.forEach(function(sc) { %>
                    <div class="col-sm-6">
                      <div class="p-2.5 rounded-xl bg-slate-950 border border-slate-800 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                          <div class="w-7 h-7 rounded-lg bg-slate-800 flex items-center justify-center text-amber-400 text-xs">
                            <i class="bi bi-film"></i>
                          </div>
                          <div>
                            <div class="text-xs font-semibold text-white"><%= sc.screen_name %></div>
                            <div class="text-[10px] text-slate-400"><%= sc.total_capacity %> physical seats</div>
                          </div>
                        </div>
                        <span class="badge bg-slate-800 text-slate-300 border border-slate-700 text-[10px] px-2 py-1 rounded-md">2D Standard</span>
                      </div>
                    </div>
                  <% }); %>
                <% } else { %>
                  <div class="text-xs text-slate-400 italic">No screens configured for this theater yet.</div>
                <% } %>
              </div>

              <!-- Upcoming Showtimes at this theater -->
              <h6 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Upcoming Screenings</h6>
              <% if (t.upcomingShowtimes && t.upcomingShowtimes.length > 0) { %>
                <div class="d-flex flex-wrap gap-2 mb-3">
                  <% t.upcomingShowtimes.forEach(function(show) { %>
                    <a href="/movies/<%= show.movie_id %>/showtimes" class="btn btn-dark btn-sm rounded-xl px-2.5 py-1 text-xs border border-slate-800 hover:border-amber-500/50 hover:bg-slate-800 transition-all text-slate-200 d-flex align-items-center gap-1.5">
                      <span class="text-amber-400 font-semibold"><%= String(show.start_time).slice(0, 5) %></span>
                      <span class="text-slate-300 truncate" style="max-width: 110px;"><%= show.movie_title %></span>
                      <span class="badge bg-slate-700 text-slate-200 text-[9px] py-0.5">₹<%= parseFloat(show.ticket_price).toFixed(0) %></span>
                    </a>
                  <% }); %>
                </div>
              <% } else { %>
                <p class="text-xs text-slate-400 italic mb-3">No active showtimes scheduled for this theater today.</p>
              <% } %>
            </div>

            <!-- Footer Action -->
            <div class="p-3 bg-slate-950/60 border-t border-slate-800/80 d-flex justify-content-between align-items-center">
              <span class="text-xs text-slate-400">
                <i class="bi bi-clock-history me-1 text-slate-400"></i> Multiple show timings available
              </span>
              <a href="/movies/showtimes?city=<%= encodeURIComponent(t.city) %>" class="btn btn-warning btn-sm rounded-xl px-3 font-semibold text-slate-950 text-xs">
                View Showtimes <i class="bi bi-arrow-right ms-1"></i>
              </a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="text-center py-5 rounded-2xl bg-slate-900/40 border border-slate-800 p-5">
      <i class="bi bi-buildings text-4xl text-slate-400 mb-3 d-block"></i>
      <h3 class="text-xl font-bold text-white mb-2">No Theaters Found</h3>
      <p class="text-slate-400 text-sm mb-4">No cinema complexes found for the selected filter.</p>
      <a href="/theaters" class="btn btn-outline-warning rounded-pill px-4 text-xs font-semibold">
        Reset Filter
      </a>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<div class="container py-5">
  <!-- Page Header -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom border-secondary border-opacity-25">
    <div>
      <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-1.5 rounded-pill small fw-semibold text-uppercase mb-2">
        <i class="bi bi-buildings-fill me-1"></i> Theater Complexes
      </span>
      <h1 class="display-6 fw-bold text-white mb-1">
        Cinema Venues &amp; Screens
      </h1>
      <p class="text-secondary small mb-0">
        Browse partner theaters, auditoriums, seating layouts, and daily movie schedules.
      </p>
    </div>

    <!-- City Filter Form -->
    <form action="/theaters" method="GET" class="d-flex align-items-center gap-2">
      <div class="input-group">
        <span class="input-group-text bg-dark border-secondary border-opacity-25 text-secondary">
          <i class="bi bi-geo-alt"></i>
        </span>
        <select name="city" class="form-select bg-dark text-light border-secondary border-opacity-25" onchange="this.form.submit()">
          <option value="">All Cities</option>
          <% if (typeof cities !== 'undefined' && cities) { %>
            <% cities.forEach(function(c) { %>
              <option value="<%= c %>" <%= selectedCity === c ? 'selected' : '' %>><%= c %></option>
            <% }); %>
          <% } %>
        </select>
      </div>
      <% if (selectedCity) { %>
        <a href="/theaters" class="btn btn-outline-secondary btn-sm rounded-pill px-3 text-light">
          Clear
        </a>
      <% } %>
    </form>
  </div>

  <!-- Theater Cards List -->
  <% if (theaters && theaters.length > 0) { %>
    <div class="row g-4">
      <% theaters.forEach(function(t) { %>
        <div class="col-lg-6">
          <div class="card h-100 bg-secondary bg-opacity-10 border border-secondary border-opacity-25 rounded-4 shadow-sm overflow-hidden">
            <!-- Theater Header Banner -->
            <div class="p-4 bg-dark bg-opacity-50 border-bottom border-secondary border-opacity-25">
              <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                  <h4 class="fw-bold text-white mb-1"><%= t.name %></h4>
                  <p class="text-secondary small mb-0 d-flex align-items-center gap-1.5">
                    <i class="bi bi-geo-alt-fill text-warning"></i>
                    <%= t.address %>, <span class="text-warning fw-semibold"><%= t.city %></span>
                  </p>
                </div>
                <div class="text-end">
                  <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-1.5 rounded-pill fw-semibold">
                    <i class="bi bi-display me-1"></i> <%= t.total_screens %> Screen<%= t.total_screens > 1 ? 's' : '' %>
                  </span>
                  <div class="small text-secondary mt-1">
                    Capacity: <strong class="text-white"><%= t.total_capacity %></strong> seats
                  </div>
                </div>
              </div>
            </div>

            <!-- Body: Screens and Features -->
            <div class="p-4">
              <h6 class="small fw-bold text-secondary text-uppercase mb-3">Auditoriums / Screens</h6>
              <div class="row g-2 mb-4">
                <% if (t.screens && t.screens.length > 0) { %>
                  <% t.screens.forEach(function(sc) { %>
                    <div class="col-sm-6">
                      <div class="p-3 rounded-3 bg-black border border-secondary border-opacity-25 d-flex justify-content-between align-items-center gap-2">
                        <div class="d-flex align-items-center gap-2">
                          <div class="rounded-2 bg-dark text-warning p-2 d-flex align-items-center justify-content-center" style="width: 34px; height: 34px;">
                            <i class="bi bi-display"></i>
                          </div>
                          <div>
                            <div class="small fw-semibold text-white"><%= sc.screen_name %></div>
                            <div class="text-secondary" style="font-size: 0.75rem;"><%= sc.total_capacity %> seats</div>
                          </div>
                        </div>
                        <span class="badge bg-secondary bg-opacity-25 text-secondary border border-secondary border-opacity-25 px-2 py-1 small">Active</span>
                      </div>
                    </div>
                  <% }); %>
                <% } else { %>
                  <div class="small text-secondary fst-italic">No screens configured for this theater yet.</div>
                <% } %>
              </div>

              <!-- Upcoming Showtimes at this theater -->
              <h6 class="small fw-bold text-secondary text-uppercase mb-2">Today's Screenings</h6>
              <% if (t.upcomingShowtimes && t.upcomingShowtimes.length > 0) { %>
                <div class="d-flex flex-wrap gap-2 mb-2">
                  <% t.upcomingShowtimes.forEach(function(show) { %>
                    <a href="/movies/<%= show.movie_id %>/showtimes" class="btn btn-dark btn-sm rounded-pill px-3 text-light border border-secondary border-opacity-25 d-flex align-items-center gap-1.5 text-decoration-none">
                      <span class="text-warning fw-bold"><%= String(show.start_time).slice(0, 5) %></span>
                      <span class="text-light text-truncate" style="max-width: 120px;"><%= show.movie_title %></span>
                      <span class="badge bg-secondary bg-opacity-50 text-light py-0.5">₹<%= parseFloat(show.ticket_price).toFixed(0) %></span>
                    </a>
                  <% }); %>
                </div>
              <% } else { %>
                <p class="small text-secondary fst-italic mb-2">No active showtimes scheduled for this theater today.</p>
              <% } %>
            </div>

            <!-- Footer Action -->
            <div class="p-3 bg-dark bg-opacity-25 border-top border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
              <span class="small text-secondary">
                <i class="bi bi-clock-history me-1"></i> Multiple shows daily
              </span>
              <a href="/movies/showtimes?city=<%= encodeURIComponent(t.city) %>" class="btn btn-warning btn-sm rounded-pill px-3 fw-semibold text-dark">
                View Showtimes <i class="bi bi-arrow-right ms-1"></i>
              </a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } else { %>
    <div class="text-center py-5 rounded-4 bg-secondary bg-opacity-10 border border-secondary border-opacity-25 p-5">
      <i class="bi bi-buildings fs-1 text-secondary mb-3 d-block"></i>
      <h3 class="fw-bold text-white mb-2">No Theaters Found</h3>
      <p class="text-secondary small mb-4">No cinema complexes found for the selected city filter.</p>
      <a href="/theaters" class="btn btn-outline-warning rounded-pill px-4 btn-sm fw-semibold">
        Reset Filter
      </a>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
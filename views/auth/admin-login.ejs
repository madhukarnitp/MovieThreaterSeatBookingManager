<%- include('../partials/header') %>

<div class="container py-5 my-auto">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-5 col-xl-4">
      <div class="card bg-secondary bg-opacity-10 border border-danger-subtle rounded-4 shadow-lg p-4 p-md-5">
        
        <!-- Header -->
        <div class="text-center mb-4">
          <div class="d-inline-flex align-items-center justify-content-center bg-danger text-white rounded-circle mb-3" style="width: 52px; height: 52px; font-size: 1.5rem;">
            <i class="bi bi-shield-lock-fill"></i>
          </div>
          <h2 class="fw-bold text-white mb-1">Operations Portal</h2>
          <p class="text-secondary small mb-0">Authorized theater administration and operational staff only</p>
        </div>

        <!-- Form Validation Errors -->
        <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
          <div class="alert alert-danger alert-dismissible fade show border-0 mb-4" role="alert">
            <ul class="mb-0 ps-3 small">
              <% errors.forEach(function(error) { %>
                <li><%= error %></li>
              <% }); %>
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% } %>

        <!-- Admin Login Form -->
        <form action="/auth/admin/login" method="POST" novalidate>
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

          <!-- Email -->
          <div class="mb-3">
            <label for="email" class="form-label text-light small fw-semibold">
              <i class="bi bi-envelope me-1 text-danger"></i> Admin Email
            </label>
            <input 
              type="email" 
              class="form-control bg-dark text-light border-secondary-subtle py-2 px-3" 
              id="email" 
              name="email" 
              placeholder="admin@cinema.com"
              value="<%= typeof oldInput !== 'undefined' && oldInput.email ? oldInput.email : '' %>"
              required
              autofocus
            >
          </div>

          <!-- Password -->
          <div class="mb-4">
            <label for="password" class="form-label text-light small fw-semibold mb-1">
              <i class="bi bi-key me-1 text-danger"></i> Security Password
            </label>
            <input 
              type="password" 
              class="form-control bg-dark text-light border-secondary-subtle py-2 px-3" 
              id="password" 
              name="password" 
              placeholder="Enter administrator password"
              required
            >
          </div>

          <!-- Submit Button -->
          <button type="submit" class="btn btn-danger w-100 py-2 fw-semibold rounded-3 mb-3 shadow-sm">
            <i class="bi bi-shield-check me-1"></i> Authenticate Administrator
          </button>
        </form>

        <!-- Sample Credentials Box -->
        <div class="p-3 bg-dark bg-opacity-75 rounded-3 border border-secondary-subtle small text-secondary mb-3">
          <div class="fw-semibold text-light mb-1"><i class="bi bi-info-circle me-1 text-info"></i> Seed Admin Credentials:</div>
          <div>Email: <code>admin@cinema.com</code></div>
          <div>Password: <code>Admin@123</code></div>
        </div>

        <!-- Note on Security -->
        <div class="text-center pt-3 border-top border-secondary-subtle">
          <p class="text-secondary small mb-0">
            <i class="bi bi-lock me-1"></i> Admin registration is restricted to controlled database operations.
          </p>
        </div>

      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

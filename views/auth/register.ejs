<%- include('../partials/header') %>

<div class="container py-5 my-auto">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 col-xl-5">
      <div class="card bg-secondary bg-opacity-10 border border-secondary-subtle rounded-4 shadow-lg p-4 p-md-5">
        
        <!-- Header -->
        <div class="text-center mb-4">
          <div class="d-inline-flex align-items-center justify-content-center bg-warning text-dark rounded-circle mb-3" style="width: 52px; height: 52px; font-size: 1.5rem;">
            <i class="bi bi-person-plus-fill"></i>
          </div>
          <h2 class="fw-bold text-white mb-1">Create Account</h2>
          <p class="text-secondary small mb-0">Join CineSeat to explore movies &amp; book premier theater seats</p>
        </div>

        <!-- Form Validation Errors Summary -->
        <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
          <div class="alert alert-danger alert-dismissible fade show border-0 mb-4" role="alert">
            <div class="fw-semibold mb-1 d-flex align-items-center gap-1">
              <i class="bi bi-exclamation-triangle-fill"></i> Please correct the following errors:
            </div>
            <ul class="mb-0 ps-3 small">
              <% errors.forEach(function(error) { %>
                <li><%= error %></li>
              <% }); %>
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% } %>

        <!-- Registration Form -->
        <form action="/register" method="POST" novalidate>
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

          <!-- Full Name -->
          <div class="mb-3">
            <label for="full_name" class="form-label text-light small fw-semibold">
              <i class="bi bi-person me-1 text-warning"></i> Full Name <span class="text-danger">*</span>
            </label>
            <input 
              type="text" 
              class="form-control bg-dark text-light border-secondary-subtle py-2 px-3" 
              id="full_name" 
              name="full_name" 
              placeholder="e.g. Alex Johnson"
              value="<%= typeof oldInput !== 'undefined' && oldInput.full_name ? oldInput.full_name : '' %>"
              required
              autofocus
            >
          </div>

          <!-- Email Address -->
          <div class="mb-3">
            <label for="email" class="form-label text-light small fw-semibold">
              <i class="bi bi-envelope me-1 text-warning"></i> Email Address <span class="text-danger">*</span>
            </label>
            <input 
              type="email" 
              class="form-control bg-dark text-light border-secondary-subtle py-2 px-3" 
              id="email" 
              name="email" 
              placeholder="name@example.com"
              value="<%= typeof oldInput !== 'undefined' && oldInput.email ? oldInput.email : '' %>"
              required
            >
          </div>

          <!-- Phone Number -->
          <div class="mb-3">
            <label for="phone" class="form-label text-light small fw-semibold">
              <i class="bi bi-telephone me-1 text-warning"></i> Phone Number <span class="text-secondary">(Optional)</span>
            </label>
            <input 
              type="tel" 
              class="form-control bg-dark text-light border-secondary-subtle py-2 px-3" 
              id="phone" 
              name="phone" 
              placeholder="+91 9876543210"
              value="<%= typeof oldInput !== 'undefined' && oldInput.phone ? oldInput.phone : '' %>"
            >
          </div>

          <!-- Password -->
          <div class="mb-3">
            <label for="password" class="form-label text-light small fw-semibold">
              <i class="bi bi-lock me-1 text-warning"></i> Password <span class="text-danger">*</span>
            </label>
            <input 
              type="password" 
              class="form-control bg-dark text-light border-secondary-subtle py-2 px-3" 
              id="password" 
              name="password" 
              placeholder="Minimum 8 characters"
              required
            >
            <div class="form-text text-secondary small">Must be at least 8 characters long.</div>
          </div>

          <!-- Confirm Password -->
          <div class="mb-4">
            <label for="confirm_password" class="form-label text-light small fw-semibold">
              <i class="bi bi-lock-fill me-1 text-warning"></i> Confirm Password <span class="text-danger">*</span>
            </label>
            <input 
              type="password" 
              class="form-control bg-dark text-light border-secondary-subtle py-2 px-3" 
              id="confirm_password" 
              name="confirm_password" 
              placeholder="Re-type your password"
              required
            >
          </div>

          <!-- Submit Button -->
          <button type="submit" class="btn btn-warning w-100 py-2 fw-semibold rounded-3 mb-3 shadow-sm">
            <i class="bi bi-check-circle me-1"></i> Complete Registration
          </button>
        </form>

        <!-- Card Footer -->
        <div class="text-center pt-3 border-top border-secondary-subtle">
          <p class="text-secondary small mb-0">
            Already have an account? 
            <a href="/login" class="text-warning text-decoration-none fw-semibold">Sign in here</a>
          </p>
        </div>

      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
